---
import Base from '../layouts/Base.astro';
import FaqDiet from '../components/FaqDiet.astro';
import CtaFinal from '../components/CtaFinal.astro';
import { SITE } from '../data/site';
import { cabinetJsonLd, faqJsonLd } from '../data/jsonld';
import { FAQ_DIET } from '../data/contenu';

const siteUrl =
  (import.meta.env.SITE ?? '').replace(/\/$/, '') +
  import.meta.env.BASE_URL.replace(/\/$/, '') +
  '/contact/';

const jsonLd = [...SITE.cabinets.map((c) => cabinetJsonLd(c, siteUrl)), faqJsonLd(FAQ_DIET)];
---

<Base
  titre="Contact et prise de RDV | Anne-Charlotte Diététicienne"
  description="Prendre rendez-vous avec Anne-Charlotte, diététicienne à Namur et Malonne : en ligne (le plus rapide), au cabinet, par téléphone ou WhatsApp au +32 472 62 91 95."
  chemin="/contact/"
  jsonLd={jsonLd}
>
  <section class="hero-contact fond-sapin">
    <div class="contenu">
      <h1>Discutons, dès aujourd’hui</h1>
      <p class="hero-sous">Choisis ce qui est le plus simple pour toi : tout marche.</p>
    </div>
  </section>

  <section>
    <div class="contenu" data-reveal>
      <!-- Le geste principal, mis en scène seul -->
      <div class="moyen-principal">
        <div>
          <h2>Réserver en ligne <span class="pastille">plus rapide</span></h2>
          <p>
            Tu choisis ton créneau, la confirmation est immédiate. En visio
            depuis chez toi, ou au cabinet.
          </p>
        </div>
        <a class="btn btn-rose" href={SITE.rdvVisio}>Prendre RDV en visio</a>
      </div>

      <!-- Les autres chemins, en rangées -->
      <div class="rangs">
        <div class="rang moyen">
          <h3>WhatsApp ou téléphone</h3>
          <p>Une question avant de réserver ? Je te réponds directement.</p>
          <a class="btn btn-contour" href={SITE.whatsappMessage}>{SITE.telephone}</a>
        </div>
        {SITE.cabinets.map((cabinet) => (
          <div class="rang moyen">
            <h3>{cabinet.nom}</h3>
            <p>
              {cabinet.rue}, {cabinet.codePostal} {cabinet.ville} (BE) ·{' '}
              {SITE.horaires}
            </p>
            <a class="btn btn-contour" href={cabinet.rdv}>RDV à {cabinet.ville}</a>
          </div>
        ))}
        <div class="rang moyen">
          <h3>Par e-mail</h3>
          <p>Pour tout le reste, y compris les demandes professionnelles.</p>
          <a class="btn btn-contour" href={'mailto:' + SITE.email}>{SITE.email}</a>
        </div>
      </div>
    </div>
  </section>

  <FaqDiet />
  <CtaFinal />
</Base>

<style>
  .hero-contact { padding: 56px 0 48px; }
  .hero-sous { font-size: 18.5px; margin: 0; }

  .moyen-principal {
    display: flex;
    flex-direction: column;
    gap: 18px;
    align-items: flex-start;
    background: var(--sapin);
    border-radius: var(--rayon-grand);
    padding: 30px 28px;
    margin-bottom: 34px;
  }
  @media (min-width: 820px) {
    .moyen-principal {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 48px;
    }
    .moyen-principal .btn { flex: none; }
  }
  .moyen-principal h2 {
    color: var(--ecru);
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    font-size: 27px;
    margin-bottom: 8px;
  }
  .moyen-principal p { color: #DCD5C6; margin: 0; }

  .rang.moyen { grid-template-columns: 1fr; }
  @media (min-width: 760px) {
    .rang.moyen {
      grid-template-columns: 240px 1fr auto;
      align-items: center;
    }
  }
  .rang.moyen .btn { min-height: 48px; padding: 10px 20px; font-size: 16px; justify-self: start; }
  @media (min-width: 760px) { .rang.moyen .btn { justify-self: end; } }
</style>
