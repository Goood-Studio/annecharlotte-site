---
// L'accueil : la photo d'Anne-Charlotte en arche (clin d'œil aux cadres de
// son cabinet), le geste principal « Prendre RDV en ligne », et des blocs
// d'action nets. Contenu dans la largeur lisible, jamais pleine page.
import Base from '../layouts/Base.astro';
import Tarifs from '../components/Tarifs.astro';
import Nutriciens from '../components/Nutriciens.astro';
import CtaFinal from '../components/CtaFinal.astro';
import ChatFaq from '../components/ChatFaq.astro';
import villesData from '../data/villes.json';
import articlesData from '../data/articles.json';
import { SITE, u } from '../data/site';
import { cabinetJsonLd } from '../data/jsonld';

const villes = villesData.villes;
const derniersArticles = articlesData.articles.slice(0, 3);
const siteUrl =
  (import.meta.env.SITE ?? '').replace(/\/$/, '') +
  import.meta.env.BASE_URL.replace(/\/$/, '') +
  '/';

const jsonLd = SITE.cabinets.map((c) => cabinetJsonLd(c, siteUrl));
---

<Base
  titre="Diététicienne à Namur, troubles digestifs & santé féminine | Anne-Charlotte Jalhay"
  description="Anne-Charlotte, diététicienne agréée à Namur et Malonne : troubles digestifs (SII, ballonnements), santé féminine (SOPK, endométriose), mieux manger sans culpabilité. Prends RDV en ligne, en visio ou au cabinet."
  chemin="/"
  jsonLd={jsonLd}
  animer={true}
>
  <!-- HERO : contenu, pas pleine largeur -->
  <section class="hero">
    <div class="contenu hero-grille">
      <div class="hero-photo" data-anim="photo">
        <img
          src={u('/img/hero-900.jpg')}
          srcset={`${u('/img/hero-900.jpg')} 900w, ${u('/img/hero-1600.jpg')} 1600w`}
          sizes="(min-width: 900px) 38vw, 86vw"
          alt="Anne-Charlotte Jalhay, diététicienne, souriante devant un mur vert"
          fetchpriority="high"
        />
      </div>

      <div class="hero-texte">
        <h1 data-anim="titre">Retrouve du plaisir à&nbsp;manger, sans culpabilité</h1>
        <p class="hero-chapo" data-anim="chapo">
          Ici Anne-Charlotte, <strong>diététicienne spécialisée en troubles
          digestifs et santé féminine</strong>. Plus de
          <em>1 500 patient·es</em> accompagné·es et <em>250 diététicien·nes</em>
          formées, toujours à ton rythme et avec le sourire.
        </p>

        <div class="hero-actions">
          <a class="bloc-action principal" href={SITE.rdvVisio} data-anim="bloc">
            <span class="bloc-titre">Prendre RDV en ligne <span class="pastille">plus rapide</span></span>
            <span class="bloc-sous">En visio, depuis chez toi. Confirmation immédiate.</span>
            <span class="bloc-fleche" aria-hidden="true">→</span>
          </a>
          <a class="bloc-action" href={SITE.rdvMalonne} data-anim="bloc">
            <span class="bloc-titre">Prendre RDV à Malonne</span>
            <span class="bloc-sous">Au cabinet, rue Chapelle Lessire 54 (ou à Namur).</span>
            <span class="bloc-fleche" aria-hidden="true">→</span>
          </a>
          <a class="bloc-action" href={SITE.gooodeat} data-anim="bloc">
            <span class="bloc-titre">Télécharger l’app Gooodeat</span>
            <span class="bloc-sous">Pour déculpabiliser ton alimentation au quotidien.</span>
            <span class="bloc-fleche" aria-hidden="true">→</span>
          </a>
          <a class="bloc-action" href="https://www.vroooz.com" data-anim="bloc">
            <span class="bloc-titre">Vérifie ce que tu as entendu</span>
            <span class="bloc-sous">Un conseil nutrition vu sur TikTok ? Passe-le dans Vroooz.</span>
            <span class="bloc-fleche" aria-hidden="true">→</span>
          </a>
          <a class="bloc-action" href={SITE.whatsappMessage} data-anim="bloc">
            <span class="bloc-titre">Poser une question</span>
            <span class="bloc-sous">Réponse directe sur WhatsApp.</span>
            <span class="bloc-fleche" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Les trois piliers : un index éditorial, pas des cartes -->
  <section>
    <div class="contenu" data-reveal>
      <h2>Comment te sens-tu&nbsp;?</h2>
      <p class="section-chapo">
        Estomac en galère, hormones en folie, vie à 100 à l’heure ? Il y a
        sûrement une solution du côté de ton assiette.
      </p>
      <div class="rangs">
        <a class="rang rang-lien" href={u('/troubles-digestifs/')}>
          <h3>Troubles digestifs</h3>
          <p>Maux de ventre, ballonnements, reflux, intestin irritable (SII), SIBO… Chaque ajustement compte.</p>
          <span class="rang-fleche" aria-hidden="true">→</span>
        </a>
        <a class="rang rang-lien" href={u('/sante-feminine/')}>
          <h3>Santé féminine</h3>
          <p>SOPK, endométriose, syndrome prémenstruel, cycles difficiles… L’alimentation joue un vrai rôle.</p>
          <span class="rang-fleche" aria-hidden="true">→</span>
        </a>
        <a class="rang rang-lien" href={u('/mieux-manger/')}>
          <h3>Mieux manger</h3>
          <p>Mal dans ton corps, envie de mieux manger sans régime punitif ? Retrouvons ta confiance.</p>
          <span class="rang-fleche" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- L'approche : un manifeste, pas quatre mini-cartes -->
  <section class="fond-sapin approche">
    <div class="contenu" data-reveal>
      <h2>Viens comme tu es</h2>
      <dl class="valeurs">
        <div class="valeur">
          <dt>Positivité</dt>
          <dd>Bonne humeur, sourire, écoute active et professionnalisme.</dd>
        </div>
        <div class="valeur">
          <dt>Ouverture</dt>
          <dd>Chacun·e a un vécu unique et mérite d’être écouté·e, sans jugement.</dd>
        </div>
        <div class="valeur">
          <dt>Scientifique</dt>
          <dd>Une pratique basée sur les preuves. Plus de 3 h par semaine à me former.</dd>
        </div>
        <div class="valeur">
          <dt>Impact</dt>
          <dd>Prendre soin de soi, c’est déjà rendre le monde un peu meilleur.</dd>
        </div>
      </dl>
    </div>
  </section>

  <Tarifs />
  <Nutriciens />

  <!-- Le blog et les guides : contenu frais pour les humains et les moteurs -->
  <section aria-labelledby="titre-lire">
    <div class="contenu" data-reveal>
      <h2 id="titre-lire">À lire, pour commencer ce soir</h2>
      <div class="rangs">
        {derniersArticles.map((a) => (
          <a class="rang rang-lien" href={u('/articles/' + a.slug + '/')}>
            <h3>{a.titre}</h3>
            <p>{a.metaDescription}</p>
            <span class="rang-fleche" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
      <div class="lire-liens">
        <a class="btn btn-contour" href={u('/articles/')}>Tous les articles</a>
        <a class="btn btn-contour" href={u('/guides/')}>Les guides gratuits</a>
      </div>
    </div>
  </section>

  <!-- Villes : distribution du jus SEO vers les pages locales -->
  <section>
    <div class="contenu" data-reveal>
      <h2>Près de chez toi</h2>
      <p class="section-chapo">
        En visio où que tu sois, ou en cabinet à Malonne et Namur.
      </p>
      <div class="villes-liens">
        {villes.map((v) => (
          <a class="ville-lien" href={u('/' + v.slug + '/')}>Diététicienne {v.ville}</a>
        ))}
      </div>
    </div>
  </section>

  <ChatFaq />

  <CtaFinal />
</Base>

<style>
  /* HERO : mobile = photo arche centrée puis actions ;
     desktop = photo à gauche (38 %), texte et actions à droite. */
  .hero { padding: 30px 0 52px; }
  .hero-grille {
    display: grid;
    grid-template-columns: 1fr;
    gap: 26px;
  }
  .hero-photo {
    justify-self: center;
    width: min(86vw, 340px);
    border-radius: 170px 170px var(--rayon-grand) var(--rayon-grand);
    overflow: hidden;
    box-shadow: 0 24px 48px -24px rgba(22, 53, 44, .45);
  }
  .hero-photo img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: center 22%;
  }
  .hero-texte h1 { margin-bottom: 14px; }
  .hero-chapo {
    font-size: 18.5px;
    color: var(--encre-2);
    margin-bottom: 24px;
  }
  .hero-chapo em {
    font-family: var(--police-titre);
    font-style: normal;
    font-size: 20px;
    color: var(--sapin);
  }

  .hero-actions { display: flex; flex-direction: column; gap: 10px; }
  .bloc-action {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2px;
    background: var(--blanc);
    border: 1.5px solid var(--ligne);
    border-radius: var(--rayon);
    padding: 15px 52px 15px 18px;
    text-decoration: none;
    min-height: 60px;
    justify-content: center;
    transition: border-color .15s ease, transform .15s cubic-bezier(.2, .8, .25, 1), box-shadow .15s ease;
  }
  .bloc-action:hover {
    border-color: var(--dore);
    transform: translateY(-2px);
    box-shadow: 0 10px 24px -14px rgba(22, 53, 44, .35);
  }
  .bloc-action:active { transform: none; }
  .bloc-action.principal { background: var(--sapin); border-color: var(--sapin); }
  .bloc-titre {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    font-weight: 800;
    font-size: 17.5px;
    color: var(--sapin);
  }
  .bloc-sous { color: var(--encre-2); font-size: 14.5px; }
  .bloc-action.principal .bloc-titre { color: var(--ecru); }
  .bloc-action.principal .bloc-sous { color: var(--rose); }
  .bloc-fleche {
    position: absolute;
    right: 18px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 20px;
    color: var(--dore);
    transition: transform .15s cubic-bezier(.2, .8, .25, 1);
  }
  .bloc-action:hover .bloc-fleche { transform: translateY(-50%) translateX(4px); }
  .bloc-action.principal .bloc-fleche { color: var(--rose); }

  @media (min-width: 900px) {
    .hero { padding: 48px 0 72px; }
    .hero-grille {
      grid-template-columns: 380px 1fr;
      gap: 56px;
      align-items: center;
    }
    .hero-photo { width: 100%; justify-self: start; }
  }

  .section-chapo { color: var(--encre-2); margin-bottom: 26px; }

  /* Rangées piliers */
  .rang-lien { position: relative; padding-right: 44px; }
  .rang-lien h3 { transition: color .15s ease; }
  .rang-lien:hover h3 { color: var(--rose-fort); }
  .rang-fleche {
    position: absolute;
    right: 6px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 22px;
    color: var(--dore);
    transition: transform .15s cubic-bezier(.2, .8, .25, 1);
  }
  .rang-lien:hover .rang-fleche { transform: translateY(-50%) translateX(6px); }

  /* Manifeste valeurs */
  .valeurs {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    margin: 8px 0 0;
  }
  .valeur {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2px 32px;
    padding: 18px 0;
    border-bottom: 1px solid var(--sapin-3);
  }
  .valeur:last-child { border-bottom: 0; }
  @media (min-width: 760px) {
    .valeur { grid-template-columns: 240px 1fr; align-items: baseline; }
  }
  .valeurs dt {
    font-family: var(--police-titre);
    font-size: 22px;
    color: var(--rose);
  }
  .valeurs dd { margin: 0; color: #DCD5C6; }
</style>
