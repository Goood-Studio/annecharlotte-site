---
// L'accueil : la photo d'Anne-Charlotte en arche (clin d'œil aux cadres de
// son cabinet), le geste principal « Prendre RDV en visio », et des blocs
// d'action nets. Contenu dans la largeur lisible, jamais pleine page.
import Base from '../layouts/Base.astro';
// 01/11/2026 : accueil allégé. Le détail du pack (Tarifs, Deroule) vit sur
// /accompagnement/ ; les apps, la chaîne WhatsApp et Nutriciens restent dans le pied de page.
import DeuxChemins from '../components/DeuxChemins.astro';
import CtaFinal from '../components/CtaFinal.astro';
import ChatFaq from '../components/ChatFaq.astro';
import Avis from '../components/Avis.astro';
import VisioRassure from '../components/VisioRassure.astro';
import { prochaineDispo } from '../data/dispos';
import villesData from '../data/villes.json';
import articlesData from '../data/articles.json';
import { SITE, u } from '../data/site';
import { cabinetJsonLd } from '../data/jsonld';
import { guideDeLArticle } from '../data/guides-site';

const villes = villesData.villes;
// 09/11/2026 : les 3 articles de l'accueil sont choisis (avec leur guide), pas
// juste les 3 derniers. Un slug absent (pas encore publié) est remplacé par
// le plus récent des autres.
const ARTICLES_ACCUEIL = ['maman-qui-s-oublie', 'ballonnements-apres-repas', 'fetes-sans-culpabiliser'];
const choisisAccueil = ARTICLES_ACCUEIL.map((slug) => articlesData.articles.find((a) => a.slug === slug)).filter(Boolean);
const derniersArticles = [...choisisAccueil, ...articlesData.articles.filter((a) => !ARTICLES_ACCUEIL.includes(a.slug))].slice(0, 3);
const siteUrl =
  (import.meta.env.SITE ?? '').replace(/\/$/, '') +
  import.meta.env.BASE_URL.replace(/\/$/, '') +
  '/';

const jsonLd = SITE.cabinets.map((c) => cabinetJsonLd(c, siteUrl));

// Lues sur cal.com au build (voir src/data/dispos.ts). null = on n'affiche rien.
const [dispoVisio, dispoMalonne] = await Promise.all([
  prochaineDispo('premiers-pas-visio'),
  prochaineDispo('premiers-pas-malonne'),
]);
---

<Base
  titre="Diététicienne à Namur, troubles digestifs & santé féminine | Anne-Charlotte Jalhay"
  description="Anne-Charlotte, diététicienne agréée à Namur et Malonne : troubles digestifs (SII, ballonnements), santé féminine (SOMP/SOPK, endométriose), mieux manger sans culpabilité. Prends rendez-vous en visio ou au cabinet."
  chemin="/"
  jsonLd={jsonLd}
  animer={true}
>
  <!-- HERO : contenu, pas pleine largeur -->
  <section class="hero">
    <div class="contenu hero-grille">
      <div class="hero-photo" data-anim="photo">
        <img
          src={u('/img/hero-900.jpg')}
          srcset={`${u('/img/hero-900.jpg')} 675w, ${u('/img/hero-1600.jpg')} 911w`}
          sizes="(min-width: 900px) 38vw, 86vw"
          alt="Anne-Charlotte Jalhay, diététicienne, souriante devant un mur vert"
          fetchpriority="high"
        />
      </div>

      <div class="hero-texte">
        <h1 data-anim="titre">Mange pour être libre</h1>
        <p class="hero-libre" data-anim="chapo">
          Libre de tes symptômes, de tes douleurs, de la culpabilité à table.
        </p>
        <p class="hero-chapo" data-anim="chapo">
          Ici Anne-Charlotte, <strong>diététicienne spécialisée en troubles
          digestifs et santé féminine</strong>. Plus de
          <em>1 500 patient·es</em> accompagné·es et <em>250 diététicien·nes</em>
          formées, toujours à ton rythme et avec le sourire.
        </p>

        <div class="hero-actions">
          <!-- 09/11/2026 (analyse UX) : une seule action dans le haut de page.
               Avant : 2 cartes de prix + l'encart visio + la note + « Poser une
               question » = 1 150 px de blocs, photo et bouton sous la ligne de
               flottaison. La formule (accompagnement mis en avant, consultation)
               se choisit sur le /bilan ; les offres sont détaillées plus bas
               (« Deux façons d'avancer ») ; les questions passent par le bouton
               WhatsApp flottant. -->
          <!-- Même libellé que la barre fixe du téléphone, qui s'efface tant que
               ce bouton est visible (data-masque-barre, voir StickyRdv). -->
          <a class="btn btn-principal hero-bouton" href={SITE.rdvVisio} data-anim="bloc" data-masque-barre>
            Prendre RDV en visio <span aria-hidden="true">→</span>
          </a>
          <p class="hero-rassure" data-anim="bloc">
            {dispoVisio && <><strong>1re dispo {dispoVisio}</strong><br /></>}
            De chez toi · dès 80&nbsp;€ · 3 minutes de questions, puis tu choisis ton créneau.
          </p>
          {!SITE.visioSeulement && (
            <a class="lien-cabinet" href={SITE.rdvMalonne} data-anim="bloc">
              Plutôt au cabinet ? Consultation à Malonne
              {dispoMalonne && <span>(1re dispo : {dispoMalonne})</span>} →
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Les trois piliers : un index éditorial, pas des cartes -->
  <section>
    <div class="contenu" data-reveal>
      <h2>Comment te sens-tu&nbsp;?</h2>
      <p class="section-chapo">
        Estomac en galère, semaine de l’enfer avant les règles, vie à 100 à
        l’heure et repas qui passent à la trappe ? Il y a sûrement une solution
        du côté de ton assiette, ou juste à côté.
      </p>
      <div class="rangs">
        <a class="rang rang-lien" href={u('/troubles-digestifs/')}>
          <h3>Troubles digestifs</h3>
          <p>Nausées, ballonnements, reflux, urgences aux toilettes, constipation, SII, SIBO. Qu’ils soient fonctionnels (axe cerveau-intestin) ou liés à une maladie, chaque ajustement compte, sans restriction inutile.</p>
          <span class="rang-fleche" aria-hidden="true">→</span>
        </a>
        <a class="rang rang-lien" href={u('/sante-feminine/')}>
          <h3>Santé féminine</h3>
          <p>Endométriose, syndrome prémenstruel, périménopause, SOMP (SOPK). Comment l’alimentation peut-elle avoir un impact ? On en parle.</p>
          <span class="rang-fleche" aria-hidden="true">→</span>
        </a>
        <a class="rang rang-lien" href={u('/mieux-manger/')}>
          <h3>Mieux manger</h3>
          <p>Mal dans ton corps, envie de mieux manger sans régime punitif ? Retrouvons ta confiance.</p>
          <span class="rang-fleche" aria-hidden="true">→</span>
        </a>
        <a class="rang rang-lien" href={u('/arreter-de-fumer/')}>
          <h3>Arrêter de fumer</h3>
          <p>Envie d’arrêter, mais la peur de grossir te freine ? Diététicienne et tabacologue : on travaille les deux en même temps.</p>
          <span class="rang-fleche" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Le blog et les guides, juste après les thèmes (09/11/2026) : 3 articles choisis -->
  <section aria-labelledby="titre-lire">
    <div class="contenu" data-reveal>
      <h2 id="titre-lire">À lire, pour commencer ce soir</h2>
      <div class="rangs">
        {derniersArticles.map((a) => (
          <a class="rang rang-lien" href={u('/articles/' + a.slug + '/')}>
            <h3>{a.titre}</h3>
            <p>{a.metaDescription}</p>
            {guideDeLArticle(a)?.sien && <p class="avec-guide">Avec le guide gratuit à télécharger</p>}
            <span class="rang-fleche" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
      <div class="lire-liens">
        <a class="btn btn-contour" href={u('/articles/')}>Tous les articles et guides</a>
      </div>
    </div>
  </section>

  <DeuxChemins />

  {/* 09/11/2026 : l'encart visio (pourquoi, comment) quitte le haut de page et
      vient ici, après les offres. Un seul bouton : la réservation. */}
  {SITE.visioSeulement && (
    <section class="visio-accueil" aria-label="La consultation en visio">
      <div class="contenu" data-reveal><VisioRassure /></div>
    </section>
  )}

  <!-- L'approche : un manifeste, pas quatre mini-cartes -->
  <section class="fond-sapin approche">
    <div class="contenu" data-reveal>
      <h2>Viens comme tu es</h2>
      <dl class="valeurs">
        <div class="valeur">
          <dt>Positivité</dt>
          <dd>Bonne humeur, sourire, écoute active et professionnalisme.</dd>
        </div>
        <div class="valeur">
          <dt>Ouverture</dt>
          <dd>Chacun·e a un vécu unique et mérite d’être écouté·e, sans jugement.</dd>
        </div>
        <div class="valeur">
          <dt>Scientifique</dt>
          <dd>Une pratique basée sur les preuves. Plus de 3 h par semaine à me former.</dd>
        </div>
        <div class="valeur">
          <dt>Impact</dt>
          <dd>Prendre soin de soi, c’est déjà rendre le monde un peu meilleur.</dd>
        </div>
      </dl>
    </div>
  </section>

  <Avis />

  <!-- Villes : distribution du jus SEO vers les pages locales -->
  <section>
    <div class="contenu" data-reveal>
      <h2>Près de chez toi</h2>
      <p class="section-chapo">
        En visio où que tu sois, ou en cabinet à Malonne et Namur.
      </p>
      <div class="villes-liens">
        {villes.map((v) => (
          <a class="ville-lien" href={u('/' + v.slug + '/')}>Diététicienne {v.ville}</a>
        ))}
      </div>
    </div>
  </section>

  <ChatFaq />

  <CtaFinal />
</Base>

<style>
  .avec-guide { font-size: 13.5px !important; font-weight: 700; color: var(--dore) !important; margin-top: 6px !important; }
  /* HERO : mobile = photo arche centrée puis actions ;
     desktop = photo à gauche (38 %), texte et actions à droite. */
  .hero { padding: 30px 0 52px; }
  .hero-grille {
    display: grid;
    grid-template-columns: 1fr;
    gap: 26px;
  }
  .hero-photo {
    justify-self: center;
    width: min(86vw, 340px);
    border-radius: 170px 170px var(--rayon-grand) var(--rayon-grand);
    overflow: hidden;
    box-shadow: 0 24px 48px -24px rgba(22, 53, 44, .45);
  }
  .hero-photo img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: center 22%;
  }
  .hero-texte h1 { margin-bottom: 8px; }
  .hero-libre {
    font-family: var(--police-titre);
    font-size: 21px;
    line-height: 1.35;
    color: var(--rose-fort);
    margin-bottom: 14px;
  }
  .hero-chapo {
    font-size: 18.5px;
    color: var(--encre-2);
    margin-bottom: 24px;
  }
  .hero-chapo em {
    font-family: var(--police-titre);
    font-style: normal;
    font-size: 20px;
    color: var(--sapin);
  }

  .hero-actions { display: flex; flex-direction: column; gap: 10px; }
  /* 09/11/2026 : l'unique bouton du haut de page, et sa ligne de réassurance. */
  .hero-bouton { align-self: stretch; min-height: 58px; font-size: 18px; padding: 15px 30px; }
  .hero-rassure { margin: 2px 4px 0; font-size: 15px; line-height: 1.5; color: var(--encre-2); }
  .hero-rassure strong { color: var(--sapin); }
  @media (min-width: 900px) { .hero-bouton { align-self: flex-start; } }
  /* Sur téléphone, une photo plus petite : le titre remonte dans le premier écran. */
  @media (max-width: 899px) { .hero-photo { width: min(58vw, 230px); margin-bottom: 0; } }
  .lien-cabinet {
    margin: 2px 4px 0;
    font-size: 15px;
    font-weight: 700;
    color: var(--sapin);
  }
  .lien-cabinet span { font-weight: 400; color: var(--encre-2); }

  @media (min-width: 900px) {
    .hero { padding: 48px 0 72px; }
    .hero-grille {
      grid-template-columns: 380px 1fr;
      gap: 56px;
      align-items: center;
    }
    .hero-photo { width: 100%; justify-self: start; }
  }

  .section-chapo { color: var(--encre-2); margin-bottom: 26px; }

  /* Rangées piliers */
  .rang-lien { position: relative; padding-right: 44px; }
  .rang-lien h3 { transition: color .15s ease; }
  .rang-lien:hover h3 { color: var(--rose-fort); }
  .rang-fleche {
    position: absolute;
    right: 6px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 22px;
    color: var(--dore);
    transition: transform .15s cubic-bezier(.2, .8, .25, 1);
  }
  .rang-lien:hover .rang-fleche { transform: translateY(-50%) translateX(6px); }

  /* Manifeste valeurs */
  .valeurs {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    margin: 8px 0 0;
  }
  .valeur {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2px 32px;
    padding: 18px 0;
    border-bottom: 1px solid var(--sapin-3);
  }
  .valeur:last-child { border-bottom: 0; }
  @media (min-width: 760px) {
    .valeur { grid-template-columns: 240px 1fr; align-items: baseline; }
  }
  .valeurs dt {
    font-family: var(--police-titre);
    font-size: 22px;
    color: var(--rose);
  }
  .valeurs dd { margin: 0; color: #DCD5C6; }
</style>
