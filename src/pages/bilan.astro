---
// Le miroir avant réservation. Quelques questions courtes, puis la
// personne choisit son créneau sur cal.com. Ses réponses partent vers le
// relais Netlify, qui écrit une fiche dans la base Notion « Demandes avant
// RDV ». Un code au hasard (BIL-XXXX) est ajouté au lien cal.com pour
// relier la fiche à la réservation : aucune donnée personnelle dans l'URL.
// Page technique : noindex, hors sitemap, rien gardé dans le navigateur.
import Base from '../layouts/Base.astro';
import { SITE, u } from '../data/site';
import { MOTIFS } from '../data/miroir';

// En local, PUBLIC_BILAN_ENDPOINT pointe vers le relais à blanc (dev.mjs).
const endpoint = import.meta.env.PUBLIC_BILAN_ENDPOINT || SITE.bilanEndpoint;
const lieux: [id: string, label: string, lien: string][] = [
  ['pack', 'Réserver mon pack tout compris', SITE.calPack],
  ['tabac', 'Réserver mon pack tabac', SITE.calPackTabac],
  ['visio', 'En visio', SITE.calVisio],
  ['malonne', 'Au cabinet de Malonne', SITE.calMalonne],
  ['namur', 'Au cabinet de Namur', SITE.calNamur],
];
---

<Base
  titre="Avant ton rendez-vous | Anne-Charlotte Diététicienne"
  description="Trois minutes pour me dire ce que tu vis, avant de choisir ton créneau avec Anne-Charlotte, diététicienne à Namur, Malonne et en visio."
  chemin="/bilan/"
  noindex
>
  <section class="bilan">
    <div class="contenu etroit">
      <p class="surtitre">Avant ton rendez-vous</p>
      <h1>Dis-moi ce que tu vis</h1>

      <noscript>
        <p class="alerte">
          Cette page a besoin de JavaScript. Pas de souci :
          <a href={SITE.calVisio}>réserve directement ton rendez-vous ici</a>.
        </p>
      </noscript>

      <div class="progression" aria-hidden="true" hidden><div class="progres-barre"><span></span></div></div>
      <p class="etape-num" aria-live="polite" hidden></p>

      <form id="miroir" data-endpoint={endpoint} novalidate hidden>
        <div class="piege" aria-hidden="true">
          <label>Ton site web <input type="text" name="site_web" tabindex="-1" autocomplete="off" /></label>
        </div>

        <!-- 1. Qui -->
        <fieldset class="etape" data-etape="qui">
          <legend class="h2">On fait connaissance ?</legend>
          <p class="chapo">
            Trois minutes pour que je comprenne ce que tu vis. Ensuite, tu choisis ton créneau.
          </p>
          <div class="champs deux">
            <label>Ton prénom <input type="text" name="prenom" autocomplete="given-name" required /></label>
            <label>
              L’initiale de ton nom
              <input type="text" name="initiale" maxlength="2" autocomplete="off" required placeholder="Ex. D" />
            </label>
          </div>
        </fieldset>

        <!-- 2. Motif + demande -->
        <fieldset class="etape" data-etape="motif" hidden>
          <legend class="h2">Tu viens pour…</legend>
          <p class="discret">Coche tout ce qui te concerne.</p>
          <div class="choix">
            {MOTIFS.map(([id, label]) => (
              <label class="option"><input type="checkbox" name="motifs" value={id} /> <span>{label}</span></label>
            ))}
          </div>
          <label class="question">
            Comment est-ce que je peux t’aider ?
            <span class="aide">Avec tes mots, même en vrac.</span>
            <textarea name="demande" rows="5"></textarea>
          </label>
        </fieldset>

        <!-- 3. Point B -->
        <fieldset class="etape" data-etape="pointb" hidden>
          <legend class="h2">Si dans 3 mois ça allait mieux, qu’est-ce qui aurait changé ?</legend>
          <p class="discret">Dans ta journée, ton corps, ta tête… ce qui te vient.</p>
          <textarea name="pointB" rows="5" aria-label="Qu’est-ce qui aurait changé dans 3 mois ?"></textarea>
        </fieldset>

        <!-- 4. Le miroir -->
        <fieldset class="etape" data-etape="miroir" hidden>
          <legend class="h2">Est-ce que tu te reconnais ?</legend>
          <p class="discret">Ce sont des phrases que j’entends souvent en consultation.</p>
          <div class="roue-scene"><div class="roue" data-roue></div></div>
          <div class="phrases"></div>
          <p class="entendu" hidden>
            Ce que tu vis, je l’entends très souvent. Et ça se travaille : on part de ton quotidien,
            et on teste une seule chose à la fois.
          </p>
        </fieldset>

        <!-- 5. Déjà essayé -->
        <fieldset class="etape" data-etape="essaye" hidden>
          <legend class="h2">Qu’est-ce que tu as déjà essayé ?</legend>
          <p class="discret">Régimes, médecins, applis, conseils d’amies… et ce que ça a donné.</p>
          <textarea name="dejaEssaye" rows="5" aria-label="Ce que tu as déjà essayé"></textarea>
        </fieldset>

        <!-- 6. Le rendez-vous -->
        <fieldset class="etape" data-etape="rdv" hidden>
          <legend class="h2">Choisis ton rendez-vous</legend>
          <p class="photos" hidden>
            <strong>Un petit service avant qu’on se voie :</strong> si tu es à l’aise, prends en photo ce
            que tu manges pendant 2 ou 3 jours. Sinon, pas de souci, on en parle ensemble.
          </p>
          <p class="discret">
            Tes réponses sont pour moi, Anne-Charlotte Jalhay, et restent privées : personne d’autre ne
            les voit. Elles servent seulement à préparer notre rendez-vous. Si tu ne réserves pas, elles
            sont effacées après 3 mois. Pour les voir ou les faire supprimer, écris-moi à
            <a href="mailto:annecharlotte@gooodeat.com">annecharlotte@gooodeat.com</a>
            (<a href={u('/technique/politique-confidentialite/')}>confidentialité</a>).
          </p>
          <label class="consentement">
            <input type="checkbox" name="consentement" required />
            <span>J’accepte qu’Anne-Charlotte reçoive ces réponses pour préparer mon rendez-vous.</span>
          </label>
          <div class="lieux">
            {lieux.map(([id, label, lien]) => (
              <>
                {id === 'visio' && <p class="sous-lieux" hidden>Ou d’abord une première consultation :</p>}
                <button type="button" class:list={['btn', id === 'visio' ? 'btn-principal' : 'btn-contour', 'btn-bloc']} data-lieu={id} data-lien={lien} hidden={id === 'pack' || id === 'tabac'}>
                  {label}
                  {id === 'visio' && <span class="pastille">plus rapide</span>}
                </button>
              </>
            ))}
          </div>
        </fieldset>

        <p class="erreur" role="alert" hidden></p>

        <div class="nav">
          <button type="button" class="btn btn-contour" data-retour hidden>Retour</button>
          <button type="button" class="btn btn-principal" data-suite>Commencer</button>
        </div>
      </form>
    </div>
  </section>
</Base>

<style>
  :global(.barre-rdv) { display: none; }
  :global(body) { padding-bottom: 0; }

  .bilan {
    --z-1: #C96C80;
    --z-2: #B98D45;
    --z-3: #16352C;
    --anneau: #E9DFD0;
    --scene: #F3ECE1;
    padding: 40px 0 72px;
  }
  .etroit { max-width: 680px; }
  .surtitre { font-size: 13px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--rose-fort); margin-bottom: 6px; }
  h1 { font-size: clamp(28px, 6vw, 40px); margin-bottom: 22px; }
  .h2 { font-family: var(--police-titre); font-weight: 400; line-height: 1.18; color: var(--sapin); font-size: clamp(24px, 5vw, 32px); padding: 0; margin: 0 0 14px; text-wrap: balance; }
  legend:focus { outline: none; }
  .chapo { font-size: 19px; }
  .discret { color: var(--encre-2); font-size: 16px; }
  .aide { font-weight: 400; color: var(--encre-2); font-size: 14.5px; }
  .alerte { background: var(--rose-2); border-radius: var(--rayon); padding: 16px 18px; }

  .progression { margin-bottom: 8px; }
  .progres-barre { height: 8px; border-radius: 999px; background: var(--ecru-2); overflow: hidden; }
  .progres-barre span { display: block; height: 100%; width: 0; background: var(--rose-fort); border-radius: 999px; transition: width .35s cubic-bezier(.2, .8, .25, 1); }
  .etape-num { font-size: 14px; color: var(--encre-2); margin-bottom: 26px; }

  fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
  .etape { display: flex; flex-direction: column; gap: 16px; }
  .etape[hidden] { display: none; }

  label { display: flex; flex-direction: column; gap: 6px; font-weight: 700; color: var(--sapin); font-size: 16px; }
  .question { font-family: var(--police-titre); font-weight: 400; font-size: 22px; margin-top: 10px; }
  .question textarea, .question .aide { font-family: var(--police-texte); }
  input[type='text'], textarea {
    width: 100%; min-height: 52px; border-radius: 12px; border: 2px solid var(--ligne); background: var(--blanc);
    color: var(--encre); font-family: var(--police-texte); font-size: 16.5px; font-weight: 400; padding: 12px 14px;
  }
  textarea { resize: vertical; line-height: 1.5; }
  input:focus-visible, textarea:focus-visible { outline: 3px solid var(--dore); outline-offset: 1px; border-color: var(--dore); }
  .champs { display: grid; gap: 14px; }
  @media (min-width: 640px) { .champs.deux { grid-template-columns: 1fr 1fr; } }

  .choix { display: grid; gap: 10px; }
  .option {
    flex-direction: row; align-items: center; gap: 12px; min-height: 54px; padding: 12px 16px; background: var(--blanc);
    border: 2px solid var(--ligne); border-radius: 14px; cursor: pointer; font-weight: 600;
  }
  .option input { width: 20px; height: 20px; accent-color: var(--sapin); flex: none; margin: 0; }
  .option:has(input:checked) { border-color: var(--sapin); background: var(--rose-2); }

  .roue-scene { background: var(--scene); border-radius: var(--rayon-grand); padding: 10px; }
  .roue { max-width: 170px; margin: 0 auto; }
  .roue :global(svg) { width: 100%; height: auto; display: block; }

  .phrases { display: grid; gap: 14px; }
  .bilan :global(.phrase) { background: var(--blanc); border: 2px solid var(--ligne); border-radius: 18px; padding: 14px 14px 12px; display: grid; gap: 10px; }
  .bilan :global(.phrase-texte) { font-family: var(--police-titre); color: var(--sapin); font-size: 19px; line-height: 1.3; margin: 0; }
  .bilan :global(.niveaux) { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .bilan :global(.niveau) {
    display: flex; align-items: center; justify-content: center; min-height: 46px; border-radius: 999px; cursor: pointer;
    border: 2px solid var(--ligne); font-weight: 700; font-size: 14.5px; color: var(--sapin); text-align: center; padding: 6px 8px;
  }
  .bilan :global(.niveau input) { position: absolute; opacity: 0; pointer-events: none; }
  .bilan :global(.niveau:has(input:checked)) { background: var(--sapin); border-color: var(--sapin); color: var(--ecru); }
  .bilan :global(.niveau:has(input:focus-visible)) { outline: 3px solid var(--dore); outline-offset: 2px; }
  .entendu { background: var(--rose-2); border-radius: var(--rayon); padding: 16px 18px; font-size: 17px; color: var(--sapin); margin: 0; }

  .photos { background: var(--ecru-2); border-radius: var(--rayon); padding: 16px 18px; margin: 0; }
  .consentement { flex-direction: row; align-items: flex-start; gap: 12px; font-weight: 600; }
  .consentement input { width: 22px; height: 22px; margin-top: 2px; accent-color: var(--sapin); flex: none; }
  .lieux { display: grid; gap: 12px; margin-top: 6px; }
  .lieux [hidden] { display: none; }
  .sous-lieux { margin: 8px 0 0; font-weight: 700; color: var(--sapin); }

  .piege { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .erreur { color: #A8452F; font-weight: 700; margin: 18px 0 0; }
  .nav { display: flex; gap: 12px; justify-content: space-between; margin-top: 30px; flex-wrap: wrap-reverse; }
  .nav [data-suite] { margin-left: auto; min-width: 180px; }
  .nav [data-suite][hidden], .nav [data-retour][hidden] { display: none; }
  @media (max-width: 480px) { .nav .btn { flex: 1; } }
</style>

<script>
  import { phrasesPour } from '../data/miroir';

  const form = document.getElementById('miroir') as HTMLFormElement;
  const debut = Date.now();
  const q = <T extends Element = HTMLInputElement>(sel: string, racine: ParentNode = form) => racine.querySelector(sel) as T;
  const qa = <T extends Element = HTMLInputElement>(sel: string, racine: ParentNode = form) => [...racine.querySelectorAll(sel)] as T[];
  const val = (nom: string) => (q(`[name="${nom}"]`) as HTMLInputElement | null)?.value.trim() ?? '';
  const coches = (nom: string) => qa(`[name="${nom}"]:checked`).map((i) => i.value);
  const esc = (s: string) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  // Le code qui relie la fiche à la réservation cal.com (pas de donnée perso).
  const ALPHABET = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
  const ref = 'BIL-' + [...crypto.getRandomValues(new Uint8Array(5))].map((n) => ALPHABET[n % ALPHABET.length]).join('');

  // ---------- le miroir ----------
  const niveaux: Record<string, number> = {};
  const phrases = () => phrasesPour(coches('motifs'));
  const couleurs = ['var(--z-1)', 'var(--z-2)', 'var(--z-3)'];

  const TAU = Math.PI * 2;
  const pt = (cx: number, cy: number, r: number, a: number) => [cx + r * Math.sin(a), cy - r * Math.cos(a)];
  function part(cx: number, cy: number, r0: number, r1: number, a0: number, a1: number) {
    if (r1 <= r0 + 0.01) r1 = r0 + 0.01;
    const [x0, y0] = pt(cx, cy, r1, a0), [x1, y1] = pt(cx, cy, r1, a1), [x2, y2] = pt(cx, cy, r0, a1), [x3, y3] = pt(cx, cy, r0, a0);
    const g = a1 - a0 > Math.PI ? 1 : 0;
    return `M${x0.toFixed(2)} ${y0.toFixed(2)} A${r1} ${r1} 0 ${g} 1 ${x1.toFixed(2)} ${y1.toFixed(2)} L${x2.toFixed(2)} ${y2.toFixed(2)} A${r0} ${r0} 0 ${g} 0 ${x3.toFixed(2)} ${y3.toFixed(2)} Z`;
  }
  // La roue, sans étiquettes : un pétale par phrase, qui se remplit quand la
  // personne s'y reconnaît. Au centre, une silhouette : la personne au centre.
  function roue() {
    const liste = phrases(), N = liste.length, c = 150, r0 = 34, R = 138, jeu = 0.04;
    const parMotif = N === 6 ? 6 : N === 8 ? 4 : 3;
    let s = `<svg viewBox="0 0 300 300" role="img" aria-label="Ta roue">`;
    [0.5, 1].forEach((k) => (s += `<circle cx="${c}" cy="${c}" r="${r0 + (R - r0) * k}" fill="none" stroke="var(--anneau)"/>`));
    liste.forEach((p, i) => {
      const a0 = (i * TAU) / N + jeu, a1 = ((i + 1) * TAU) / N - jeu, v = (niveaux[p.texte] ?? 0) / 2;
      s += `<path d="${part(c, c, r0, R, a0, a1)}" fill="#fff" opacity=".7"/>`;
      if (v > 0) s += `<path d="${part(c, c, r0, r0 + (R - r0) * v, a0, a1)}" fill="${couleurs[Math.floor(i / parMotif) % 3]}" opacity=".9"/>`;
    });
    const k = r0 / 62, h = (x: number, y: number) => `${(c + x * k).toFixed(1)} ${(c + y * k).toFixed(1)}`;
    s += `<circle cx="${c}" cy="${c}" r="${r0 - 3}" fill="var(--scene)" stroke="var(--anneau)"/>
      <g fill="none" stroke="var(--encre)" stroke-width="${(2.4 * k).toFixed(2)}" stroke-linecap="round">
      <circle cx="${c}" cy="${(c - 24 * k).toFixed(1)}" r="${(11 * k).toFixed(1)}"/>
      <path d="M${h(-22, 34)} C${h(-22, 6)} ${h(-14, -6)} ${h(0, -7)} C${h(14, -6)} ${h(22, 6)} ${h(22, 34)}"/></g></svg>`;
    q<HTMLElement>('[data-roue]').innerHTML = s;
    const touchees = liste.filter((p) => (niveaux[p.texte] ?? 0) > 0).length;
    q<HTMLElement>('.entendu').hidden = touchees === 0;
  }
  function afficherPhrases() {
    const noms = ['pas moi', 'un peu', 'tout à fait'];
    q<HTMLElement>('.phrases').innerHTML = phrases().map((p, i) => `
      <div class="phrase" role="radiogroup" aria-label="${esc(p.texte)}">
        <p class="phrase-texte">${esc(p.texte)}</p>
        <div class="niveaux">${noms.map((n, v) => `
          <label class="niveau"><input type="radio" name="phrase-${i}" value="${v}" ${(niveaux[p.texte] ?? -1) === v ? 'checked' : ''}>${n}</label>`).join('')}
        </div>
      </div>`).join('');
    qa<HTMLInputElement>('.phrases input').forEach((inp) =>
      inp.addEventListener('change', () => {
        niveaux[phrases()[+inp.name.split('-')[1]].texte] = +inp.value;
        roue();
      })
    );
    roue();
  }
  const aMenager = () => phrases().some((p) => p.menager && niveaux[p.texte] === 2);

  // ---------- la navigation ----------
  const etapes = qa<HTMLFieldSetElement>('.etape');
  const retour = q<HTMLButtonElement>('[data-retour]'), suite = q<HTMLButtonElement>('[data-suite]');
  const erreur = q<HTMLElement>('.erreur');
  const barre = document.querySelector('.progres-barre span') as HTMLElement;
  const numero = document.querySelector('.etape-num') as HTMLElement;
  let ici = 0;

  function valider(nom: string) {
    if (nom === 'qui' && !val('prenom')) return 'Dis-moi ton prénom.';
    if (nom === 'qui' && !val('initiale')) return 'Il me manque l’initiale de ton nom.';
    if (nom === 'motif' && !coches('motifs').length) return 'Coche au moins une case, même à peu près.';
    return '';
  }
  function montrer(i: number) {
    ici = Math.max(0, Math.min(i, etapes.length - 1));
    etapes.forEach((e, k) => (e.hidden = k !== ici));
    const nom = etapes[ici].dataset.etape;
    if (nom === 'miroir') afficherPhrases();
    if (nom === 'rdv') q<HTMLElement>('.photos').hidden = aMenager();
    retour.hidden = ici === 0;
    suite.hidden = nom === 'rdv';
    suite.textContent = ici === 0 ? 'Commencer' : 'Continuer';
    barre.style.width = `${Math.round((ici / (etapes.length - 1)) * 100)}%`;
    numero.textContent = `Étape ${ici + 1} sur ${etapes.length}`;
    erreur.hidden = true;
    window.scrollTo({ top: 0, behavior: 'smooth' });
    (etapes[ici].querySelector('legend') as HTMLElement).focus({ preventScroll: true });
  }
  suite.addEventListener('click', () => {
    const probleme = valider(etapes[ici].dataset.etape!);
    if (probleme) { erreur.textContent = probleme; erreur.hidden = false; return; }
    montrer(ici + 1);
  });
  retour.addEventListener('click', () => montrer(ici - 1));

  // ---------- l'envoi, puis cal.com ----------
  function reponses(lieu: string) {
    return {
      site_web: val('site_web'),
      dureeSecondes: Math.round((Date.now() - debut) / 1000),
      ref,
      prenom: val('prenom'),
      initiale: val('initiale'),
      motifs: coches('motifs'),
      demande: val('demande'),
      pointB: val('pointB'),
      miroir: phrases().map((p) => ({ phrase: p.texte, niveau: niveaux[p.texte] ?? null })),
      dejaEssaye: val('dejaEssaye'),
      lieu,
      consentement: q('[name="consentement"]').checked,
    };
  }
  qa<HTMLButtonElement>('[data-lieu]').forEach((bouton) =>
    bouton.addEventListener('click', async () => {
      if (!q('[name="consentement"]').checked) {
        erreur.textContent = 'Coche la case pour que je puisse recevoir tes réponses.';
        erreur.hidden = false;
        return;
      }
      qa<HTMLButtonElement>('[data-lieu]').forEach((b) => (b.disabled = true));
      bouton.textContent = 'Un instant…';
      // La réservation ne doit jamais dépendre de l'envoi : s'il échoue ou
      // traîne, on part quand même sur cal.com après 4 secondes maximum.
      const endpoint = form.dataset.endpoint;
      if (endpoint) {
        await Promise.race([
          fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(reponses(bouton.dataset.lieu!)),
            keepalive: true,
          }).catch(() => null),
          new Promise((r) => setTimeout(r, 4000)),
        ]);
      }
      const lien = new URL(bouton.dataset.lien!);
      lien.searchParams.set('notes', `Réf. ${ref}`);
      lien.searchParams.set('metadata[ref]', ref);
      window.location.href = lien.toString();
    })
  );

  // Arrivée depuis un bouton de pack (tout compris ou tabac) : ce pack passe en premier.
  const formule = new URLSearchParams(location.search).get('formule');
  if (formule === 'pack' || formule === 'tabac') {
    const pack = q<HTMLButtonElement>(`[data-lieu="${formule}"]`);
    pack.hidden = false;
    pack.classList.replace('btn-contour', 'btn-principal');
    q<HTMLButtonElement>('[data-lieu="visio"]').classList.replace('btn-principal', 'btn-contour');
    q<HTMLElement>('.sous-lieux').hidden = false;
  }

  form.hidden = false;
  (document.querySelector('.progression') as HTMLElement).hidden = false;
  numero.hidden = false;
  qa<HTMLElement>('legend').forEach((l) => (l.tabIndex = -1));
  montrer(0);
</script>
