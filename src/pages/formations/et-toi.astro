---
// Page « Et toi, dans tout ça ? » : l'accompagnement autonome sur WhatsApp, avec Floris (17/11/2026).
// Reprise de la maquette validée par Anne-Charlotte (canevas https://claude.ai/artifact/7HxNxVMY13aFqvnL56RjUC,
// version 14). Remplace l'ancienne page « formation en ligne » en 10 chapitres (voir l'historique git).
// Cible : les femmes qui gèrent tout et s'oublient au passage (pas seulement la périménopause).
// Tant que le bilan n'est pas prêt : boutons « Je fais mon bilan » grisés, « Bientôt disponible », et la
// liste d'attente (#prevenir, lien depuis /bingo/suite/). Prix : 59 € (puis 79 €) ou 119 € avec un appel ;
// à deux, 99 € et 199 € (choix Seule / À deux en bas de page).
// Le jour de l'ouverture : remplacer les <span aria-disabled> par des liens vers le bilan.
import Base from '../../layouts/Base.astro';
import ListeAttente from '../../components/ListeAttente.astro';
import { u } from '../../data/site';

const IMG = {
  floris: u('/img/et-toi/anne-charlotte-floris.jpg'),
  murVert: u('/img/et-toi/anne-charlotte-mur-vert.jpg'),
  pastille: u('/img/et-toi/floris-pastille.svg'),
  assiette1: u('/img/et-toi/assiette-1.jpg'),
  assiette2: u('/img/et-toi/assiette-2.jpg'),
  assiette3: u('/img/et-toi/assiette-3.jpg'),
  maman: u('/img/formation/maman-assiette.jpg'),
};

// Les jauges et les semaines des écrans WhatsApp (reprises de la maquette).
const C = 169.65;
const gauge = (label: string, p: number) => ({
  label,
  dash: Math.round(Math.min(p, 1) * C) + ' 200',
  color: p >= 1 ? '#16352C' : '#B98D45',
  check: p >= 1 ? 1 : 0,
});
const days = (flags: number[]) => ['L', 'M', 'M', 'J', 'V', 'S', 'D'].map((l, i) => ({ l, on: !!flags[i], off: !flags[i] }));
const heroGauges = [gauge('Protéines', 1), gauge('Fruits', 0.7), gauge('Complètes', 0.5), gauge('Légumes', 0.15)];
const cardGauges = [gauge('Protéines', 0.3), gauge('Légumes', 0.6), gauge('Fruits', 1), gauge('Complètes', 0.4)];
const week = days([1, 1, 1, 0, 0, 0, 0]);
const duoA = days([1, 1, 1, 1, 1, 0, 0]);
const duoB = days([1, 1, 0, 1, 1, 0, 0]);
const wave = [6, 10, 14, 8, 16, 12, 18, 9, 13, 7, 15, 11, 6, 12, 8, 14, 10, 6].map((h) => ({ h: h + 'px' }));
---

