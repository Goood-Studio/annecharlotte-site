<script>
  // Seule / À deux : change les prix et les lignes de l'offre.
  const boutons = document.querySelectorAll<HTMLButtonElement>('.et-qui');
  boutons.forEach((b) => b.addEventListener('click', () => {
    const deux = b.dataset.qui === 'deux';
    boutons.forEach((x) => {
      const actif = x === b;
      x.setAttribute('aria-pressed', String(actif));
      x.style.background = actif ? '#16352C' : 'transparent';
      x.style.color = actif ? '#FAF5EE' : '#16352C';
    });
    document.querySelectorAll<HTMLElement>('[data-seule]').forEach((el) => {
      el.textContent = (deux ? el.dataset.deux : el.dataset.seule) ?? '';
    });
  }));
</script>

