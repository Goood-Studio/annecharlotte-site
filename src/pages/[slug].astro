---
// Le gabarit des pages villes. Une page par ville publiée dans le CMS Notion
// (généré : src/data/villes.json). La structure est commune, les champs
// locaux (intro, quartiers, accès, FAQ locale) rendent chaque page unique.
// Le RDV en visio est toujours l'action principale ; le cabinet n'est
// proposé qu'aux villes de la commune de Namur (champ Consultation du CMS).
import Base from '../layouts/Base.astro';
import Tarifs from '../components/Tarifs.astro';
import FaqDiet from '../components/FaqDiet.astro';
import Nutriciens from '../components/Nutriciens.astro';
import CtaFinal from '../components/CtaFinal.astro';
import villesData from '../data/villes.json';
import { SITE, u } from '../data/site';
import { faqJsonLd, villeJsonLd } from '../data/jsonld';
import { FAQ_DIET, SERVICES } from '../data/contenu';

export function getStaticPaths() {
  return villesData.villes.map((ville) => ({
    params: { slug: ville.slug },
    props: { ville },
  }));
}

const { ville } = Astro.props;

const proposeCabinet = (ville.consultation ?? []).includes('Cabinet Malonne');

const siteUrl =
  (import.meta.env.SITE ?? '').replace(/\/$/, '') +
  import.meta.env.BASE_URL.replace(/\/$/, '') +
  '/' + ville.slug + '/';

const jsonLd = [
  villeJsonLd(ville.ville, siteUrl),
  faqJsonLd([...ville.faqLocale, ...FAQ_DIET]),
];

const autresVilles = villesData.villes.filter((v) => v.slug !== ville.slug);
---

<Base
  titre={ville.metaTitle}
  description={ville.metaDescription}
  chemin={'/' + ville.slug + '/'}
  jsonLd={jsonLd}
>
  <!-- Hero local -->
  <section class="hero-ville fond-sapin">
    <div class="contenu">
      <h1>Ta diététicienne à {ville.ville}</h1>
      <p class="chapeau">
        Spécialisée en <strong>troubles digestifs</strong> et
        <strong>santé féminine</strong> : ballonnements, SII, endométriose,
        SOMP (SOPK), mieux manger sans culpabilité.
      </p>
      <p class="intro-locale">{ville.introLocale}</p>
      <div class="hero-boutons">
        <a class="btn btn-rose" href={SITE.rdvVisio}>
          Prendre RDV en visio <span class="pastille">plus rapide</span>
        </a>
        {proposeCabinet && (
          <a class="btn btn-contour-clair" href={SITE.rdvMalonne}>Prendre RDV au cabinet</a>
        )}
        {!proposeCabinet && (
          <a class="btn btn-contour-clair" href={SITE.whatsappMessage}>Poser une question</a>
        )}
      </div>
      <p class="hero-preuve">
        Plus de <strong>1 500 patient·es</strong> accompagné·es, à leur rythme et avec le sourire.
      </p>
    </div>
  </section>

  <!-- Infos pratiques locales -->
  <section aria-labelledby="titre-pratique">
    <div class="contenu" data-reveal>
      <h2 id="titre-pratique">Consulter depuis {ville.ville}</h2>
      <div class="pratique">
        <div>
          <h3>{proposeCabinet ? 'Comment venir (ou pas)' : 'Comment ça se passe'}</h3>
          <p>{ville.acces}</p>
          <p><strong>Horaires :</strong> {SITE.horaires}</p>
        </div>
        <div>
          <h3>La zone que je couvre</h3>
          <p>{ville.quartiers}.</p>
          <p>
            Et si tu es ailleurs : la visio marche partout, le suivi est
            exactement le même.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ locale -->
  <section aria-labelledby="titre-faq-locale" class="fond-ecru2">
    <div class="contenu" data-reveal>
      <h2 id="titre-faq-locale">On me demande souvent, à {ville.ville}</h2>
      <div class="faq-liste">
        {ville.faqLocale.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <div class="reponse"><p>{item.r}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Ce que je propose : liste éditoriale -->
  <section aria-labelledby="titre-services">
    <div class="contenu" data-reveal>
      <h2 id="titre-services">Un accompagnement complet, à ton rythme</h2>
      <div class="rangs">
        {SERVICES.map((service) => (
          <div class="rang">
            <h3>{service.titre}</h3>
            <p>{service.texte}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Tarifs />
  <FaqDiet />
  <Nutriciens />

  <!-- Maillage : les villes voisines -->
  <section aria-labelledby="titre-voisines">
    <div class="contenu" data-reveal>
      <h2 id="titre-voisines">Je consulte aussi près de chez toi</h2>
      <div class="villes-liens">
        {autresVilles.map((v) => (
          <a class="ville-lien" href={u('/' + v.slug + '/')}>Diététicienne {v.ville}</a>
        ))}
      </div>
    </div>
  </section>

  <CtaFinal />
</Base>

<style>
  .hero-ville { padding: 56px 0; }
  .chapeau { font-size: 18.5px; max-width: 58ch; }
  .intro-locale {
    font-family: var(--police-titre);
    font-size: 20px;
    line-height: 1.5;
    color: var(--ecru);
    max-width: 56ch;
    margin-top: 6px;
  }
  .hero-boutons { display: flex; flex-wrap: wrap; gap: 12px; margin: 22px 0 16px; }
  .btn-contour-clair {
    background: transparent;
    color: var(--ecru);
    border-color: var(--ecru);
  }
  .btn-contour-clair:hover { background: var(--ecru); color: var(--sapin); }
  .hero-preuve { font-size: 15.5px; color: #B9C4BC; margin: 0; }

  .pratique {
    display: grid;
    grid-template-columns: 1fr;
    gap: 22px 56px;
  }
  @media (min-width: 760px) { .pratique { grid-template-columns: 1fr 1fr; } }
  .pratique h3 { margin-bottom: 8px; }
  .pratique p { color: var(--encre-2); }
  .pratique p strong { color: var(--sapin); }

  .fond-ecru2 { background: var(--ecru-2); }
  .fond-ecru2 details { border-color: #D8CCB8; }
</style>
