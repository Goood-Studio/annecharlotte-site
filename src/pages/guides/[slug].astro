---
// La page d'un guide publié. Depuis le 09/11/2026 : plus de formulaire, le
// PDF se télécharge directement. Quand un article explique le guide, la page
// y renvoie (c'est là que tout est raconté, le PDF est aussi sous l'article).
import Base from '../../layouts/Base.astro';
import GuideTelecharger from '../../components/GuideTelecharger.astro';
import AvancerEnsemble from '../../components/AvancerEnsemble.astro';
import { guidesPublies, articleDuGuide } from '../../data/guides-site';
import { u } from '../../data/site';

export function getStaticPaths() {
  return guidesPublies.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}

const { guide } = Astro.props;
const article = articleDuGuide(guide.slug);
---

<Base
  titre={guide.titre + ' (guide gratuit) | Anne-Charlotte Diététicienne'}
  description={guide.metaDescription || guide.accroche}
  chemin={'/guides/' + guide.slug + '/'}
>
  <section class="hero-guide fond-sapin">
    <div class="contenu">
      <p class="guide-pilier">{guide.pilier} · guide gratuit</p>
      <h1>{guide.titre}</h1>
      <p class="hero-sous">{guide.accroche}</p>
    </div>
  </section>

  <section>
    <div class="contenu guide-corps" data-reveal>
      <GuideTelecharger guide={guide} kicker="À télécharger, gratuit" />
      {article && (
        <p class="guide-article">
          Tout est expliqué dans l’article
          <a href={u('/articles/' + article.slug + '/')}>« {article.titre} »</a>.
        </p>
      )}
    </div>
  </section>

  <AvancerEnsemble apresGuide />
</Base>

<style>
  .hero-guide { padding: 56px 0 48px; }
  .guide-pilier {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--rose);
    margin-bottom: 10px;
  }
  .hero-sous { font-size: 18.5px; max-width: 56ch; margin: 0; }
  .guide-corps { max-width: 780px; }
  .guide-article { font-size: 17px; margin-top: 18px; }
</style>
