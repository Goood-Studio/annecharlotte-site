---
// La section Guides : les lead magnets, venus du CMS Notion.
// 09/11/2026 : plus de formulaire (prénom, WhatsApp, e-mail). Chaque guide
// mène à l'article qui l'explique, avec le PDF à télécharger juste en
// dessous ; un guide sans article mène à sa propre page de téléchargement.
// Un guide « En préparation » s'affiche en teaser, sans captation.
import Base from '../../layouts/Base.astro';
import AvancerEnsemble from '../../components/AvancerEnsemble.astro';
import guidesData from '../../data/guides.json';
import { guidesPublies, articleDuGuide, poidsPdf } from '../../data/guides-site';
import { u } from '../../data/site';

const enPreparation = guidesData.guides.filter((g) => g.statut === 'En préparation');

const ordre = ['Troubles digestifs', 'Santé féminine', 'Mieux manger', 'Arrêt du tabac'];
const parPilier: Record<string, typeof guidesPublies> = {};
for (const g of guidesPublies) (parPilier[g.pilier ?? 'Autres'] ??= []).push(g);
const piliers = [...ordre.filter((p) => parPilier[p]), ...Object.keys(parPilier).filter((p) => !ordre.includes(p))];

const lien = (slug: string) => {
  const article = articleDuGuide(slug);
  return article ? u('/articles/' + article.slug + '/') : u('/guides/' + slug + '/');
};
---

<Base
  titre="Les guides gratuits | Anne-Charlotte Diététicienne"
  description="Les guides gratuits d'Anne-Charlotte, diététicienne : ventre gonflé, gaz, constipation, cycle, périménopause, sommeil, fringales, idées repas, arrêt du tabac. À télécharger directement, sans formulaire."
  chemin="/guides/"
>
  <section class="hero-guides fond-sapin">
    <div class="contenu">
      <h1>Des guides gratuits, concrets, à garder</h1>
      <p class="hero-sous">
        Le condensé de ce que je répète en consultation, mis en forme pour que
        tu puisses agir dès ce soir. Chaque guide est expliqué dans un article,
        et tu le télécharges juste en dessous. Sans formulaire.
      </p>
    </div>
  </section>

  {piliers.map((pilier) => (
    <section aria-label={pilier}>
      <div class="contenu" data-reveal>
        <h2>{pilier}</h2>
        <div class="rangs">
          {parPilier[pilier].map((g) => (
            <a class="rang rang-guide" href={lien(g.slug)}>
              <h3>{g.titre}</h3>
              <p>{g.accroche}</p>
              <p class="rang-pdf">Guide PDF{poidsPdf(g.slug) ? ' · ' + poidsPdf(g.slug) : ''} · à lire et télécharger</p>
              <span class="rang-fleche" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}

  {enPreparation.length > 0 && (
  <section aria-label="Guides en préparation">
    <div class="contenu" data-reveal>
      <h2>Bientôt disponibles</h2>
      <div class="teasers">
        {enPreparation.map((g) => (
          <div class="teaser">
            <p class="teaser-pilier">{g.pilier}</p>
            <h3>{g.titre}</h3>
            <p class="teaser-accroche">{g.accroche}</p>
            <ul>
              {g.contenuListe.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
  )}

  <AvancerEnsemble />
</Base>

<style>
  .hero-guides { padding: 56px 0 48px; }
  .hero-sous { font-size: 18.5px; max-width: 58ch; margin: 0; }

  .rang-guide { position: relative; padding-right: 44px; }
  .rang-guide h3 { transition: color .15s ease; }
  .rang-guide:hover h3 { color: var(--rose-fort); }
  .rang-guide .rang-pdf { font-size: 13.5px; font-weight: 700; color: var(--dore); margin-top: 6px; }
  .rang-fleche {
    position: absolute;
    right: 6px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 22px;
    color: var(--dore);
  }

  .teasers {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
  }
  @media (min-width: 860px) { .teasers { grid-template-columns: 1fr 1fr 1fr; } }
  .teaser {
    background: var(--blanc);
    border: 1.5px solid var(--ligne);
    border-radius: var(--rayon-grand);
    padding: 24px 22px;
    display: flex;
    flex-direction: column;
  }
  .teaser-pilier {
    font-size: 12.5px;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--dore);
    margin-bottom: 8px;
  }
  .teaser h3 { margin-bottom: 8px; }
  .teaser-accroche { color: var(--encre-2); font-size: 15.5px; }
  .teaser ul { margin: 6px 0 0; padding-left: 18px; }
  .teaser li { font-size: 14.5px; color: var(--encre-2); margin-bottom: 5px; }
  .teaser li::marker { color: var(--rose-fort); }
</style>
