---
// Sous chaque article et chaque guide : après le PDF, la suite avec
// Anne-Charlotte.
// 09/11/2026 (soir) : « dans les blogs j'ai encore des doubles CTA » → une
// seule carte, un seul bouton, comme le haut de l'accueil. Les deux formules
// restent lisibles avec leur prix, mais elles se choisissent sur le /bilan
// (l'accompagnement y est mis en avant). Même libellé que la barre fixe.
import { OFFRES } from '../data/contenu';
import { SITE } from '../data/site';
interface Props {
  // true quand un guide PDF vient juste au-dessus : le chapeau en parle.
  apresGuide?: boolean;
}
const { apresGuide = false } = Astro.props;
const unique = OFFRES[0];
const pack = OFFRES[1];
---

<section class="ensemble" aria-labelledby="titre-ensemble">
  <div class="contenu">
    <div class="ensemble-carte">
      <h2 id="titre-ensemble">Et si on regardait ta situation à toi&nbsp;?</h2>
      <p class="ensemble-chapo">{apresGuide ? 'Le guide, c’est un premier pas. ' : ''}Si tu as envie qu’on avance ensemble, je te reçois en visio, de chez toi.</p>
      <ul class="ensemble-formules">
        <li><span>Une consultation, pour commencer</span><strong>{unique.prix}</strong></li>
        <li><span>L’accompagnement, 6&nbsp;séances</span><strong>{pack.prix}</strong></li>
      </ul>
      <a class="btn btn-rose ensemble-bouton" href={SITE.rdvVisio}>Prendre RDV en visio <span aria-hidden="true">→</span></a>
      <p class="ensemble-note">Tu choisis ta formule au moment de réserver.</p>
    </div>
  </div>
</section>

<style>
  .ensemble { background: var(--ecru-2); }
  .ensemble-carte {
    max-width: 720px; margin-inline: auto;
    background: var(--sapin); color: var(--ecru);
    border-radius: var(--rayon-grand); padding: 30px 26px 26px;
    display: grid; gap: 10px; justify-items: start;
  }
  .ensemble-carte h2 { color: var(--ecru); margin: 0; }
  .ensemble-chapo { color: #DCD5C6; margin: 0 0 6px; max-width: 56ch; }
  .ensemble-formules { list-style: none; margin: 0; padding: 0; width: 100%; }
  .ensemble-formules li {
    display: flex; justify-content: space-between; align-items: baseline; gap: 16px;
    padding: 11px 0; border-top: 1px solid rgba(250, 245, 238, .18);
    font-size: 16.5px; color: var(--ecru);
  }
  .ensemble-formules li:last-child { border-bottom: 1px solid rgba(250, 245, 238, .18); }
  .ensemble-formules strong { font-family: var(--police-titre); font-weight: 400; font-size: 22px; color: var(--rose); white-space: nowrap; }
  .ensemble-bouton { margin-top: 12px; }
  .ensemble-note { margin: 0; font-size: 14.5px; color: #DCD5C6; }
  @media (max-width: 599px) { .ensemble-bouton { justify-self: stretch; } }
</style>
