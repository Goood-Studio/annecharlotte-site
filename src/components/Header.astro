---
import { SITE, u } from '../data/site';
---

<header class="entete">
  <div class="contenu barre">
    <a class="logo" href={u('/')}>Anne-Charlotte<span class="logo-sous">Diététicienne</span></a>

    <nav class="nav" id="menu-principal" aria-label="Navigation principale">
      <a href={u('/troubles-digestifs/')}>Troubles digestifs</a>
      <a href={u('/sante-feminine/')}>Santé féminine</a>
      <a href={u('/mieux-manger/')}>Mieux manger</a>
      <a href={u('/articles/')}>Blog</a>
      <a href={u('/parcours/')}>Mon parcours</a>
      <a href={u('/contact/')}>Contact</a>
      <a class="btn btn-rose nav-cta" href={SITE.rdvVisio}>Prendre RDV</a>
    </nav>

    <a class="btn btn-rose cta-entete" href={SITE.rdvVisio}>Prendre RDV</a>

    <button class="burger" aria-expanded="false" aria-controls="menu-principal" id="bouton-menu">
      <span class="burger-ligne"></span>
      <span class="burger-ligne"></span>
      <span class="burger-ligne"></span>
      <span class="lecteur-ecran">Ouvrir le menu</span>
    </button>
  </div>
</header>

<style>
  .entete {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--ecru);
    border-bottom: 1px solid var(--ligne);
  }
  .barre {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    min-height: 64px;
  }
  .logo {
    font-family: var(--police-titre);
    font-size: 20px;
    color: var(--sapin);
    text-decoration: none;
    line-height: 1.05;
    display: flex;
    flex-direction: column;
  }
  .logo-sous {
    font-family: var(--police-texte);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--dore);
  }
  .nav { display: none; }
  .cta-entete { display: none; }
  .burger {
    background: none;
    border: 0;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
  }
  .burger-ligne {
    width: 26px;
    height: 3px;
    border-radius: 3px;
    background: var(--sapin);
  }
  .lecteur-ecran {
    position: absolute;
    width: 1px; height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  /* Menu mobile déplié */
  .entete.ouvert .nav {
    display: flex;
    flex-direction: column;
    position: absolute;
    left: 0; right: 0;
    top: 100%;
    background: var(--ecru);
    border-bottom: 1px solid var(--ligne);
    padding: 10px 18px 20px;
    gap: 2px;
  }
  .entete.ouvert .nav a:not(.nav-cta) {
    padding: 13px 8px;
    font-weight: 700;
    text-decoration: none;
    color: var(--sapin);
    border-bottom: 1px solid var(--ecru-2);
  }
  .entete.ouvert .nav .nav-cta { margin-top: 12px; }

  @media (min-width: 960px) {
    .burger { display: none; }
    .nav {
      display: flex;
      align-items: center;
      gap: 22px;
    }
    .nav a:not(.nav-cta) {
      text-decoration: none;
      font-weight: 600;
      color: var(--encre);
      font-size: 16px;
    }
    .nav a:not(.nav-cta):hover { color: var(--sapin); text-decoration: underline; text-decoration-color: var(--rose-fort); }
    .nav-cta { min-height: 44px; padding: 9px 20px; font-size: 16px; }
  }
</style>

<script>
  const bouton = document.getElementById('bouton-menu');
  const entete = document.querySelector('.entete');
  bouton?.addEventListener('click', () => {
    const ouvert = entete?.classList.toggle('ouvert');
    bouton.setAttribute('aria-expanded', String(!!ouvert));
  });
</script>
