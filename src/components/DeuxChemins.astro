---
// « Deux façons d'avancer » (01/11/2026) : sur l'accueil, remplace le gros
// bloc des tarifs. Une porte « ensemble » et une porte « à ton rythme » (l'accompagnement
// autonome « Et toi », sur WhatsApp avec Floris ; ce n'est plus une formation).
// 02/11/2026 : un seul bouton par carte (plus de lien secondaire en dessous).
// 18/11/2026 (ACJ) : « on a l'impression qu'une consulte avec moi, c'est 330 € ».
// La porte de gauche devient « Avec moi » et montre les 3 formules, nommées par ce que la
// personne veut (faire le point, tester puis ajuster, que ça tienne), SANS prix. Pour que la
// comparaison reste juste, la porte de droite (« En autonomie ») n'affiche plus de prix non
// plus : les prix vivent sur /accompagnement/#titre-tarifs (lien « Voir mes tarifs » du haut).
import { u } from '../data/site';

const avecMoi = [
  ['Une consultation', 'tu fais le point et tu repars avec tes premières pistes.'],
  ['Une consultation + un suivi', 'tu testes, et on ajuste deux semaines plus tard.'],
  ['L’accompagnement, 6 séances', 'pour que ça tienne : ton carnet, et moi joignable entre les séances.'],
];
---

<section class="chemins" aria-labelledby="titre-chemins">
  <div class="contenu" data-reveal>
    <h2 id="titre-chemins">Deux façons d’avancer</h2>
    <p class="section-chapo">Avec moi, en visio. Ou de ton côté, à ton rythme. Dans les deux cas&nbsp;: une habitude à la fois, et tout se mange.</p>
    <div class="chemins-grille">
      <div class="chemin chemin--ensemble">
        <span class="chemin-kicker">En visio</span>
        <h3>Avec moi</h3>
        <p>On part de ton histoire, pas d’un menu tout fait. Tu choisis jusqu’où on va ensemble&nbsp;:</p>
        <ul class="chemin-formules">
          {avecMoi.map(([nom, pour]) => <li><strong>{nom}</strong> : {pour}</li>)}
        </ul>
        <div class="chemin-actions">
          <a class="btn btn-rose" href={u('/accompagnement/#titre-tarifs')}>Voir les 3 formules</a>
        </div>
      </div>
      <div class="chemin chemin--seule">
        <span class="chemin-kicker">Sur WhatsApp · bientôt</span>
        <h3>En autonomie</h3>
        <p><strong>« Et toi, dans tout ça&nbsp;? »</strong>, l’accompagnement autonome avec Floris, mon assistante. Pour toi qui gères tout, et qui t’oublies au passage&nbsp;: chaque matin ton idée repas, et une habitude par semaine.</p>
        <div class="chemin-actions">
          <a class="btn btn-principal" href={u('/formations/et-toi/')}>Découvrir l’accompagnement autonome</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .chemins { background: var(--ecru-2); }
  .chemins-grille { display: grid; gap: 18px; margin-top: 22px; }
  @media (min-width: 760px) { .chemins-grille { grid-template-columns: 1fr 1fr; } }
  .chemin { border-radius: var(--rayon-grand); padding: 26px 24px; display: flex; flex-direction: column; gap: 8px; }
  .chemin--ensemble { background: var(--sapin); color: var(--ecru); }
  .chemin--ensemble h3 { color: var(--ecru); }
  .chemin--ensemble p { color: #DCD5C6; }
  .chemin--seule { background: var(--blanc); border: 1.5px solid var(--ligne); }
  .chemin--seule p { color: var(--encre-2); }
  .chemin--seule p strong { color: var(--sapin); }
  .chemin-kicker { font-size: 12.5px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--dore); }
  .chemin h3 { margin: 0; }
  .chemin p { margin: 0; font-size: 16.5px; }
  .chemin-formules { list-style: none; margin: 4px 0 0; padding: 0; display: grid; gap: 10px; }
  .chemin-formules li { position: relative; padding-left: 26px; font-size: 16px; line-height: 1.45; color: #DCD5C6; }
  .chemin-formules li::before { content: '✓'; position: absolute; left: 2px; top: 0; font-weight: 800; color: var(--rose); }
  .chemin-formules strong { color: var(--ecru); }
  .chemin-actions { margin-top: auto; padding-top: 14px; display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
</style>
