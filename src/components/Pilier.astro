---
// Gabarit commun des 3 pages piliers (troubles digestifs, santé féminine,
// mieux manger) : définition « dictionnaire » en hero, réponse citable
// (GEO), situations accompagnées, façon de travailler, tarifs, FAQ.
import Base from '../layouts/Base.astro';
import Tarifs from '../components/Tarifs.astro';
import FaqDiet from '../components/FaqDiet.astro';
import Nutriciens from '../components/Nutriciens.astro';
import CtaFinal from '../components/CtaFinal.astro';
import { SITE } from '../data/site';
import { faqJsonLd } from '../data/jsonld';
import { FAQ_DIET, SERVICES } from '../data/contenu';

interface Props {
  metaTitle: string;
  metaDescription: string;
  chemin: string;
  terme: string;
  nature: string;
  definition: string;
  titre: string;
  questionCle: string;
  reponseCle: string;
  symptomes: string[];
  approche: string;
  faqPilier: { q: string; r: string }[];
  /** Pilier proposé uniquement en visio : masque le bouton « cabinet ». */
  visioSeule?: boolean;
  /**
   * Les leviers de travail du pilier : on montre qu'il y en a plusieurs et
   * sur quoi chacun agit, sans donner le protocole. Section masquée si vide.
   */
  leviers?: { titre: string; texte: string }[];
  leviersTitre?: string;
}

const {
  metaTitle,
  metaDescription,
  chemin,
  terme,
  nature,
  definition,
  titre,
  questionCle,
  reponseCle,
  symptomes,
  approche,
  faqPilier,
  visioSeule = false,
  leviers = [],
  leviersTitre = 'Les leviers qu’on actionne ensemble',
} = Astro.props;

const jsonLd = [faqJsonLd([{ q: questionCle, r: reponseCle }, ...faqPilier, ...FAQ_DIET])];
---

<Base titre={metaTitle} description={metaDescription} chemin={chemin} jsonLd={jsonLd}>
  <!-- Hero définition, façon entrée de dictionnaire -->
  <section class="hero-pilier fond-sapin">
    <div class="contenu">
      <h1>{titre}</h1>
      <p class="definition">
        <span class="def-terme">{terme}</span>
        <span class="def-nature">{nature}</span> · {definition}
      </p>
      <div class="hero-boutons">
        <a class="btn btn-rose" href={SITE.rdvVisio}>
          Prendre RDV en ligne <span class="pastille">plus rapide</span>
        </a>
        {!visioSeule && (
          <a class="btn btn-contour-clair" href={SITE.rdvMalonne}>Prendre RDV au cabinet</a>
        )}
      </div>
    </div>
  </section>

  <!-- Réponse citable : la question posée à Google et aux IA, répondue net -->
  <section class="question-cle">
    <div class="contenu" data-reveal>
      <h2>{questionCle}</h2>
      <p class="reponse-cle">{reponseCle}</p>
    </div>
  </section>

  <!-- Situations accompagnées -->
  <section aria-labelledby="titre-symptomes">
    <div class="contenu" data-reveal>
      <h2 id="titre-symptomes">Les situations que j’accompagne</h2>
      <ul class="symptomes">
        {symptomes.map((s) => <li>{s}</li>)}
      </ul>
      <p class="approche-texte">{approche}</p>
    </div>
  </section>

  <!-- Les leviers du pilier : la profondeur de méthode, pas la recette -->
  {leviers.length > 0 && (
    <section aria-labelledby="titre-leviers">
      <div class="contenu" data-reveal>
        <h2 id="titre-leviers">{leviersTitre}</h2>
        <div class="rangs">
          {leviers.map((levier) => (
            <div class="rang">
              <h3>{levier.titre}</h3>
              <p>{levier.texte}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Ce que je propose : une liste éditoriale, pas des cartes -->
  <section aria-labelledby="titre-services-pilier" class="fond-ecru2">
    <div class="contenu" data-reveal>
      <h2 id="titre-services-pilier">Ce que je te propose, concrètement</h2>
      <div class="rangs">
        {SERVICES.map((service) => (
          <div class="rang">
            <h3>{service.titre}</h3>
            <p>{service.texte}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ du pilier -->
  <section aria-labelledby="titre-faq-pilier">
    <div class="contenu" data-reveal>
      <h2 id="titre-faq-pilier">On me demande souvent</h2>
      <div class="faq-liste">
        {faqPilier.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <div class="reponse"><p>{item.r}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Tarifs />
  <FaqDiet />
  <Nutriciens />
  <CtaFinal />
</Base>

<style>
  .hero-pilier { padding: 56px 0; }
  .definition {
    font-size: 18px;
    max-width: 64ch;
    color: #DCD5C6;
  }
  .def-terme {
    font-family: var(--police-titre);
    font-size: 21px;
    color: var(--rose);
  }
  .def-nature { font-style: italic; color: #B9C4BC; }
  .hero-boutons { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 22px; }
  .btn-contour-clair {
    background: transparent;
    color: var(--ecru);
    border-color: var(--ecru);
  }
  .btn-contour-clair:hover { background: var(--ecru); color: var(--sapin); }

  .question-cle { padding-bottom: 0; }
  .reponse-cle {
    font-size: 19px;
    line-height: 1.6;
    color: var(--sapin);
    background: var(--rose-2);
    border-radius: var(--rayon-grand);
    padding: 24px 28px;
    max-width: 72ch;
  }

  .symptomes {
    columns: 1;
    margin: 6px 0 20px;
    padding-left: 20px;
  }
  @media (min-width: 700px) { .symptomes { columns: 2; column-gap: 48px; } }
  .symptomes li { margin-bottom: 9px; break-inside: avoid; }
  .symptomes li::marker { color: var(--rose-fort); }
  .approche-texte { max-width: 66ch; }

  .fond-ecru2 { background: var(--ecru-2); }
</style>
