---
// Bouton WhatsApp flottant, sur toutes les pages, jamais masqué au scroll
// (règle studio sur les contrôles fixes). Vrai logo, message prérempli.
import { SITE } from '../data/site';
---

<a class="wa-flottant" href={SITE.whatsappMessage} aria-label="Poser une question sur WhatsApp">
  <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true" fill="currentColor">
    <path d="M16 2.9C8.8 2.9 3 8.7 3 15.9c0 2.3.6 4.5 1.8 6.5L3 29.1l6.9-1.8c1.9 1 4 1.6 6.1 1.6 7.2 0 13-5.8 13-13S23.2 2.9 16 2.9zm0 23.7c-1.9 0-3.8-.5-5.4-1.5l-.4-.2-4.1 1.1 1.1-4-.3-.4c-1.1-1.7-1.6-3.7-1.6-5.7 0-5.9 4.8-10.7 10.7-10.7s10.7 4.8 10.7 10.7-4.8 10.7-10.7 10.7zm5.9-8c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-1 1.2-.2.2-.4.2-.7.1-.3-.2-1.4-.5-2.6-1.6-1-.9-1.6-1.9-1.8-2.3-.2-.3 0-.5.1-.6l.5-.6c.2-.2.2-.3.3-.6.1-.2.1-.4 0-.6-.1-.2-.7-1.8-1-2.4-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.1 1.1-1.1 2.7s1.2 3.1 1.3 3.4c.2.2 2.3 3.5 5.5 4.9.8.3 1.4.5 1.9.7.8.2 1.5.2 2.1.1.6-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5-.1-.2-.3-.3-.6-.4z"/>
  </svg>
  <span class="wa-texte">Une question ?</span>
</a>

<style>
  .wa-flottant {
    position: fixed;
    right: 14px;
    bottom: 88px;
    z-index: 60;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--whatsapp);
    color: #fff;
    border-radius: 999px;
    padding: 12px 16px;
    min-height: 54px;
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
    box-shadow: 0 6px 18px rgba(22, 53, 44, .3);
  }
  .wa-flottant:hover { background: #1EBE5A; color: #fff; }
  .wa-texte { display: none; }
  @media (min-width: 860px) {
    .wa-flottant { bottom: 22px; right: 22px; }
    .wa-texte { display: inline; }
  }
</style>
