---
// Les offres : l'accompagnement prend la scène sur fond sapin, le bilan et
// « bilan + une séance » se rangent à côté, plus discrets.
// « Petit effort, gros impact » (29/10/2026) : on dit concrètement ce qu'on
// change. (31/10/2026 : plus de « il reste 250 € après le bilan ».)
//
// Deux variantes :
//   « classique » (par défaut) → Accompagnement + Bilan + Bilan et une séance
//   « tabac »                  → le Pack tabac seul, sur la page arrêt du tabac
import { OFFRES, EXEMPLES_CHANGEMENT, PACK_RYTHME, PACK_FREINS, EXEMPLES_CARNET } from '../data/contenu';
import { SITE } from '../data/site';

interface Props {
  variante?: 'classique' | 'tabac';
  // Pages villes : on retire les exemples, les rassurances et les horaires visio, sinon
  // les pages villes se ressemblent trop pour le détecteur anti-duplication.
  sobre?: boolean;
  /** L'exemple de carnet dans « À quoi ça ressemble » : general, digestif, endo. */
  exemple?: keyof typeof EXEMPLES_CARNET;
}

const { variante = 'classique', sobre = false, exemple = 'general' } = Astro.props;
const ex = EXEMPLES_CARNET[exemple];
// Le carrousel commence par le cas de la page, puis les autres.
const cas = [exemple, ...Object.keys(EXEMPLES_CARNET).filter((k) => k !== exemple)].map((k) => ({ id: k, ...EXEMPLES_CARNET[k as keyof typeof EXEMPLES_CARNET] }));
const rythme = PACK_RYTHME.map((e, i) => (i === 0 ? { ...e, quoi: ex.lendemain } : e));
const horaires = sobre ? SITE.horaires : `${SITE.horaires}, et ${SITE.horairesVisio}, pour que ça colle avec ton boulot`;

const bilan = OFFRES[0];
const pack = OFFRES[1];
const packTabac = OFFRES[2];
const deux = OFFRES[3];
const tabac = variante === 'tabac';
---

<section class="tarifs" aria-labelledby="titre-tarifs">
  <div class="contenu" data-reveal>
    <h2 id="titre-tarifs">{tabac ? 'Les tarifs, sans surprise' : 'Petit effort, gros impact'}</h2>
    {tabac ? (
      <p class="tarifs-chapo">{`Disponibilités : ${SITE.horaires}, et ${SITE.horairesVisio}. L’accompagnement à l’arrêt se fait en visio, et la mutuelle rembourse une partie.`}</p>
    ) : (
      <>
        <p class="tarifs-chapo">Pas de plan alimentaire, pas de liste d’interdits. On part de ce que tu manges déjà, et on ajoute la petite chose qui changera le plus ta journée. Puis la suivante.</p>
        {!sobre && (
          <ul class="exemples" aria-label="Par exemple">
            {EXEMPLES_CHANGEMENT.map((e) => <li>{e}</li>)}
          </ul>
        )}
      </>
    )}

    <div class:list={['offres', tabac && 'offres-seule']}>
      {tabac ? (
        <article class="offre offre-pack">
          <h3>{packTabac.nom}</h3>
          <p class="offre-prix"><span class="prix">{packTabac.prix}</span> <span class="unite">{packTabac.unite}</span></p>
          <p class="offre-desc">{packTabac.description}</p>
          <ul>
            {packTabac.inclus.map((item) => <li>{item}</li>)}
          </ul>
          <a class="btn btn-rose btn-bloc" href={SITE.rdvPackTabac}>{packTabac.ctaTexte}</a>
        </article>
      ) : (
        <>
          <article class="offre offre-pack">
            <span class="pastille">Ce que je propose</span>
            <h3>{pack.nom}</h3>
            <p class="offre-prix"><span class="prix">{pack.prix}</span> <span class="unite">{pack.unite}</span></p>
            {!sobre && <p class="offre-desc">{pack.description}</p>}
            <ul>
              {(sobre ? pack.inclus.slice(0, 2) : pack.inclus).map((item) => {
                const [cle, ...reste] = item.split(' : ');
                return reste.length ? <li><strong>{cle}</strong> · {reste.join(' : ')}</li> : <li>{item}</li>;
              })}
            </ul>
            <a class="btn btn-rose btn-bloc" href={SITE.rdvPack}>{pack.ctaTexte}</a>
          </article>

          <div class="offres-cote">
            <article class="offre offre-simple">
              <h3>{bilan.nom}</h3>
              <p class="offre-prix"><span class="prix">{bilan.prix}</span> <span class="unite">{bilan.unite}</span></p>
              <p class="offre-desc">{bilan.description}</p>
              <a class="btn btn-contour btn-bloc" href={SITE.rdvVisio}>{bilan.ctaTexte}</a>
            </article>
            <article class="offre offre-simple">
              <h3>{deux.nom}</h3>
              <p class="offre-prix"><span class="prix">{deux.prix}</span> <span class="unite">{deux.unite}</span></p>
              <p class="offre-desc">{deux.description}</p>
              <a class="btn btn-contour btn-bloc" href={SITE.rdvVisio + '?formule=deux'}>{deux.ctaTexte}</a>
            </article>
          </div>
        </>
      )}
    </div>
    {!tabac && !sobre && (
      <div class="pack-detail">
        <h3 class="pack-titre">À quoi ça ressemble, au quotidien</h3>
        <div class="pack-haut">
          <figure class="telephone" aria-label="Exemples de carnets, tels que tes patientes les reçoivent sur leur téléphone">
            <div class="cas-onglets" role="tablist" aria-label="Choisir un exemple">
              {cas.map((c, k) => <button type="button" role="tab" data-cas={k} aria-selected={k === 0 ? 'true' : 'false'}>{c.label}</button>)}
            </div>
            <div class="ecran">
              <div class="cas-piste" tabindex="0" aria-live="polite">
                {cas.map((c) => (
                  <div class="cas">
                    <p class="tel-titre">Le carnet {/^[AEIOUYÉÈÊaeiouy]/.test(c.prenom) ? `d’${c.prenom}` : `de ${c.prenom}`}</p>
                    <p class="tel-sous">Mis à jour après votre séance</p>
                    <div class="tel-carte tel-rose"><span>Pourquoi tu le fais</span>« {c.raison} »</div>
                    <div class="tel-carte tel-sapin"><span>Ta piste</span><b>{c.piste}</b>
                      {c.exos.map((t, k) => (k === 0 ? <i class="choisi">✓ {t}</i> : <i>{t}</i>))}
                    </div>
                    <div class="tel-carte"><span>Comment ça se passe ?</span>
                      <div class="tel-boutons"><em class="on">Je l’ai fait</em><em>Un peu</em><em>Pas encore</em></div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
            <div class="cas-nav">
              <button type="button" data-cas-pas="-1" aria-label="Exemple précédent">←</button>
              <span class="cas-points">{cas.map((_, k) => <i class={k === 0 ? 'on' : ''}></i>)}</span>
              <button type="button" data-cas-pas="1" aria-label="Exemple suivant">→</button>
            </div>
            <figcaption>Un carnet par patiente, sur son téléphone</figcaption>
          </figure>
          <ol class="rythme">
            {rythme.map((e) => <li><strong>{e.quand}</strong><span>{e.quoi}</span></li>)}
          </ol>
        </div>
        <h3 class="pack-titre">Tu te dis peut-être…</h3>
        <ul class="freins">
          {PACK_FREINS.map((f) => <li><p class="frein">{f.frein}</p><p>{f.reponse}</p></li>)}
        </ul>
        <a class="btn btn-rose" href={SITE.rdvPack}>{pack.ctaTexte}</a>
      </div>
    )}
    {!tabac && !sobre && (
      <ul class="rassure">
        <li>On ajoute, on ne retire pas</li>
        <li>Tes photos de repas, sans jugement</li>
        <li>{`Disponibilités : ${horaires}. La mutuelle rembourse une partie de chaque séance.`}</li>
      </ul>
    )}
    <p class="note-etoile">
      {tabac
        ? '* Valable 4 mois : les séances s’espacent selon ta situation.'
        : '* Une séance environ toutes les 2 semaines. Ta vie déborde ? On décale, sans souci.'}
    </p>
  </div>
</section>

<script>
  // Le carrousel des carnets : glisser au doigt, flèches, étiquettes, et un défilement doux
  // toutes les 5 secondes tant qu'on n'y touche pas.
  document.querySelectorAll('.telephone').forEach((tel) => {
    const piste = tel.querySelector('.cas-piste');
    if (!piste) return;
    const n = piste.children.length;
    let i = 0, auto = true;
    const montrer = (k, doux = true) => {
      i = (k + n) % n;
      piste.scrollTo({ left: piste.clientWidth * i, behavior: doux ? 'smooth' : 'auto' });
      tel.querySelectorAll('[data-cas]').forEach((b, j) => b.setAttribute('aria-selected', String(j === i)));
      tel.querySelectorAll('.cas-points i').forEach((p, j) => p.classList.toggle('on', j === i));
    };
    const stop = () => { auto = false; };
    tel.querySelectorAll('[data-cas]').forEach((b) => b.addEventListener('click', () => { stop(); montrer(+b.dataset.cas); }));
    tel.querySelectorAll('[data-cas-pas]').forEach((b) => b.addEventListener('click', () => { stop(); montrer(i + +b.dataset.casPas); }));
    let t;
    piste.addEventListener('scroll', () => { clearTimeout(t); t = setTimeout(() => { const k = Math.round(piste.scrollLeft / piste.clientWidth); if (k !== i) { i = k; montrer(k, false); } }, 120); }, { passive: true });
    ['pointerdown', 'touchstart', 'wheel'].forEach((e) => piste.addEventListener(e, stop, { passive: true }));
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) setInterval(() => { if (auto) montrer(i + 1); }, 5000);
  });
</script>

<style>
  .tarifs-chapo { color: var(--encre-2); margin-bottom: 18px; max-width: 62ch; }
  .exemples { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; padding: 0; margin: 0 0 26px; }
  .exemples li { background: var(--blanc); border: 1.5px solid var(--ligne); border-radius: 999px; padding: 6px 14px; font-size: 15px; color: var(--sapin); }
  .offres {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
    align-items: stretch;
  }
  @media (min-width: 780px) {
    .offres { grid-template-columns: 1.15fr 1fr; }
  }
  .offres-cote { display: grid; gap: 18px; }
  /* Un seul panneau : il ne s'étale pas sur toute la largeur. */
  .offres-seule { max-width: 620px; }
  @media (min-width: 780px) {
    .offres-seule { grid-template-columns: 1fr; }
  }
  .offre {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    border-radius: var(--rayon-grand);
    padding: 30px 26px 26px;
  }
  .offre-pack {
    background: var(--sapin);
    color: #DCD5C6;
  }
  .offre-pack h3 { color: var(--ecru); font-size: 26px; }
  .offre-pack .prix { color: var(--rose); }
  .offre-pack .unite { color: #B9C4BC; }
  .offre-pack .offre-desc { color: #DCD5C6; }
  .offre-pack li { color: #DCD5C6; }
  .offre-pack li::marker { color: var(--rose); }
  .offre-simple {
    background: var(--blanc);
    border: 1.5px solid var(--ligne);
    padding: 22px 22px 20px;
  }
  .offre-simple .prix { font-size: 34px; }
  .offre-simple .offre-desc { margin-bottom: 14px; }
  .offre .pastille { position: absolute; top: -12px; right: 22px; }
  .offre-prix { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; margin: 0 0 4px; }
  .prix {
    font-family: var(--police-titre);
    font-size: 42px;
    color: var(--sapin);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .unite { color: var(--encre-2); font-size: 15px; }
  .offre ul { margin: 10px 0 20px; padding-left: 20px; }
  .offre li { margin-bottom: 7px; font-size: 16px; }
  .offre .btn { margin-top: auto; }
  .regle { margin: 18px 0 0; padding: 12px 16px; background: var(--blanc); border: 1.5px solid var(--ligne); border-radius: 14px; color: var(--sapin); font-size: 15.5px; }
  .rassure { display: flex; flex-wrap: wrap; gap: 6px 22px; margin: 14px 4px 0; padding-left: 18px; color: var(--encre-2); font-size: 14.5px; }
  .note-etoile { margin: 10px 4px 0; font-size: 14.5px; color: var(--encre-2); }
  .offre-pack li strong { color: var(--ecru); }
  .pack-detail { margin-top: 30px; padding: 30px 24px; background: var(--blanc); border: 1.5px solid var(--ligne); border-radius: var(--rayon-grand); }
  .pack-titre { font-size: 24px; margin: 0 0 20px; }
  .pack-haut { display: grid; gap: 30px; align-items: center; margin-bottom: 34px; }
  @media (min-width: 780px) { .pack-haut { grid-template-columns: 290px 1fr; gap: 44px; } }

  /* Le téléphone : un aperçu dessiné en CSS de son carnet. */
  .telephone { margin: 0 auto; width: 270px; }
  .ecran { background: var(--ecru, #FAF5EE); border: 10px solid var(--sapin); border-radius: 36px; padding: 22px 14px 18px; box-shadow: 0 18px 40px rgba(22, 53, 44, .18); position: relative; }
  .ecran::before { content: ''; position: absolute; top: 7px; left: 50%; width: 64px; height: 6px; margin-left: -32px; border-radius: 99px; background: var(--sapin); opacity: .35; }
  .tel-titre { font-family: var(--police-titre); color: var(--sapin); font-size: 19px; margin: 6px 0 0; }
  .tel-sous { font-size: 11.5px; color: var(--encre-2); margin: 0 0 10px; }
  .tel-carte { background: var(--blanc); border: 1px solid var(--ligne); border-radius: 14px; padding: 9px 11px; margin-top: 8px; font-size: 12.5px; line-height: 1.4; color: var(--encre); }
  .tel-carte span { display: block; font-size: 9.5px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: var(--rose-fort, #C96C80); margin-bottom: 3px; }
  .tel-rose { background: var(--rose-2, #F7DCE1); border: 0; font-family: var(--police-titre); color: var(--sapin); font-size: 13px; }
  .tel-sapin { background: var(--sapin); border: 0; color: #DCD5C6; }
  .tel-sapin span { color: var(--rose); }
  .tel-sapin b { display: block; color: var(--ecru, #FAF5EE); font-family: var(--police-titre); font-weight: 400; font-size: 14px; margin-bottom: 6px; }
  .tel-sapin i { display: block; font-style: normal; font-size: 11.5px; padding: 5px 8px; margin-top: 4px; border-radius: 9px; background: rgba(255, 255, 255, .07); }
  .tel-sapin i.choisi { outline: 1.5px solid var(--rose); color: var(--ecru, #FAF5EE); }
  .tel-boutons { display: flex; gap: 5px; flex-wrap: wrap; }
  .tel-boutons em { font-style: normal; font-weight: 700; font-size: 11px; padding: 5px 9px; border-radius: 99px; border: 1.3px solid var(--sapin); color: var(--sapin); }
  .tel-boutons em.on { background: var(--sapin); color: var(--ecru, #FAF5EE); }
  .cas-piste { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .cas-piste::-webkit-scrollbar { display: none; }
  .cas { flex: 0 0 100%; scroll-snap-align: start; }
  .cas-onglets { display: flex; flex-wrap: wrap; justify-content: center; gap: 5px; margin-bottom: 10px; }
  .cas-onglets button { border: 1.3px solid var(--ligne); background: var(--blanc); color: var(--sapin); border-radius: 999px; padding: 5px 10px; font: inherit; font-size: 12.5px; font-weight: 700; cursor: pointer; }
  .cas-onglets button[aria-selected="true"] { background: var(--sapin); border-color: var(--sapin); color: var(--ecru, #FAF5EE); }
  .cas-nav { display: flex; align-items: center; justify-content: center; gap: 12px; margin-top: 10px; }
  .cas-nav button { width: 32px; height: 32px; border-radius: 50%; border: 1.5px solid var(--sapin); background: var(--blanc); color: var(--sapin); font-weight: 800; cursor: pointer; }
  .cas-points { display: flex; gap: 6px; }
  .cas-points i { width: 7px; height: 7px; border-radius: 50%; background: var(--ligne); }
  .cas-points i.on { background: var(--rose-fort, #C96C80); }
  .telephone figcaption { text-align: center; font-size: 14px; color: var(--encre-2); margin-top: 12px; }

  /* Le rythme : une frise, un rond par étape relié par un trait. */
  .rythme { list-style: none; margin: 0; padding: 0; counter-reset: etape; }
  .rythme li:not(:last-child)::after { content: ''; position: absolute; left: 15px; top: 30px; bottom: -2px; width: 2px; background: var(--rose); }
  .rythme li { position: relative; padding: 0 0 22px 50px; counter-increment: etape; }
  .rythme li:last-child { padding-bottom: 0; }
  .rythme li::before { content: counter(etape); position: absolute; left: 0; top: -2px; width: 32px; height: 32px; border-radius: 50%; background: var(--sapin); color: var(--ecru, #FAF5EE); font-weight: 800; font-size: 15px; display: grid; place-items: center; box-shadow: 0 0 0 5px var(--blanc); }
  .rythme strong { display: block; color: var(--sapin); font-size: 17px; }
  .rythme span { color: var(--encre-2); font-size: 15.5px; }

  /* Les hésitations : des petites cartes, la phrase entre guillemets en titre. */
  .freins { list-style: none; margin: 0 0 26px; padding: 0; display: grid; gap: 12px; }
  @media (min-width: 640px) { .freins { grid-template-columns: 1fr 1fr; } }
  .freins li { background: var(--ecru, #FAF5EE); border-radius: 18px; padding: 16px 18px; border-left: 4px solid var(--rose); }
  .freins p { margin: 0; color: var(--encre-2); font-size: 15.5px; }
  .freins .frein { font-family: var(--police-titre); color: var(--sapin); font-size: 17px; margin-bottom: 4px; }
</style>
